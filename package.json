{
  "name": "@wardby/cli",
  "version": "0.2.0",
  "description": "Self-hosted control plane for budget-guarded AI agents.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wardby/wardby#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wardby/wardby.git"
  },
  "bugs": {
    "url": "https://github.com/wardby/wardby/issues"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "self-hosted",
    "agent-governance",
    "budget-control"
  ],
  "type": "module",
  "imports": {
    "#prisma": {
      "wardby-source": "./src/generated/prisma/client.ts",
      "default": "./dist/generated/prisma/client.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "wardby": "bin/wardby.js"
  },
  "files": [
    ".env.example",
    "NOTICE",
    "bin/",
    "deploy/local/docker-compose.yml",
    "dist/",
    "prisma/migrations/",
    "prisma/schema.prisma",
    "scripts/git-askpass.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:vendor": "node scripts/build-sandbox-vendor.mjs",
    "build": "npm run build:vendor && prisma generate && tsc -p tsconfig.build.json",
    "prepare": "npm run build:vendor && prisma generate",
    "prepack": "npm run build",
    "cli": "tsx --conditions=wardby-source src/cli.ts",
    "capture:autopilot": "tsx --conditions=wardby-source src/tools/capture-autopilot-dry-run.ts",
    "test": "npm run build:vendor && vitest run",
    "test:package": "node scripts/npm-package-acceptance.mjs",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:kubernetes": "WARDBY_KUBERNETES_TEST=1 vitest run src/providers/jobs/kubernetes.integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:up": "docker compose -f deploy/local/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/local/docker-compose.yml down",
    "coding:local:up": "docker compose --env-file .env.local -f deploy/local/docker-compose.yml -f deploy/local/docker-compose.phase5.yml up --build -d coding-proxy",
    "coding:local:down": "docker compose --env-file .env.local -f deploy/local/docker-compose.yml -f deploy/local/docker-compose.phase5.yml down",
    "observability:up": "docker compose --env-file .env.local -f deploy/local/docker-compose.yml -f deploy/local/docker-compose.phase5.yml -f deploy/observability/docker-compose.grafana.yml up --build -d",
    "observability:smoke": "node scripts/grafana-smoke.mjs",
    "observability:down": "docker compose --env-file .env.local -f deploy/local/docker-compose.yml -f deploy/local/docker-compose.phase5.yml -f deploy/observability/docker-compose.grafana.yml down",
    "worker:image:local": "node scripts/build-local-coding-worker.mjs",
    "test:phase5": "vitest run src/coding/observability.test.ts src/coding/profile.test.ts src/coding/protocol.test.ts src/providers/coding-proxy/proxy.test.ts src/providers/coding-proxy/secure-fetch.test.ts src/providers/coding-proxy/metering.test.ts src/providers/coding-proxy/runtime.test.ts src/providers/executor/container.test.ts src/providers/jobs/docker.test.ts src/providers/jobs/docker-isolation.test.ts src/providers/jobs/fake.test.ts src/providers/vcs/github.test.ts src/mcp/tools/trigger.test.ts src/core/webhooks.test.ts src/claude-coding-worker/driver.test.ts src/claude-coding-worker/sdk.test.ts src/claude-coding-worker/image-policy.test.ts src/claude-tool-runner/command.test.mjs src/claude-tool-runner/main.test.mjs src/claude-tool-runner/image-policy.test.ts",
    "test:phase5:database": "vitest run src/coding/schema.database.test.ts src/providers/coding-proxy/prisma-ledger.database.test.ts src/providers/executor/container.database.test.ts src/core/coding-concurrency.database.test.ts src/core/scheduler.test.ts src/mcp/integration.test.ts",
    "verify:phase5": "npm run typecheck && npm run test:phase5 && npm run build && npm run worker:image:policy",
    "test:docker-isolation": "node scripts/docker-isolation-acceptance.mjs",
    "test:docker-job": "node scripts/docker-job-acceptance.mjs",
    "claude:images:local": "docker build -f src/claude-coding-worker/Dockerfile -t wardby-claude-coding-worker:phase5 . && docker build -f src/claude-tool-runner/Dockerfile -t wardby-claude-tool-runner:phase5 .",
    "test:claude-compatibility": "docker build -f src/claude-coding-worker/Dockerfile.compatibility -t wardby-claude-compat:phase5 . && docker run --rm wardby-claude-compat:phase5",
    "test:claude-docker": "node scripts/claude-docker-acceptance.mjs",
    "test:production-boundary": "node scripts/production-boundary-policy.mjs",
    "verify:claude-code": "npm run typecheck && npm run test:phase5 && npm run test:claude-compatibility && npm run claude:images:local && npm run test:claude-docker",
    "worker:image:policy": "node scripts/coding-worker-image-policy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.4",
    "@anthropic-ai/sdk": "^0.124.0",
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@kubernetes/client-node": "^2.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prometheus-io/client": "^0.16.1",
    "croner": "^10.0.1",
    "dotenv-flow": "^4.1.0",
    "fast-xml-parser": "^5.11.1",
    "gpt-tokenizer": "^2.5.0",
    "jose": "^6.2.12",
    "node-html-parser": "^9.0.3",
    "openai": "^4.67.0",
    "papaparse": "^5.7.0",
    "pg": "8.23.0",
    "pino": "^9.14.0",
    "quickjs-emscripten": "^0.32.0",
    "tar-stream": "^3.2.1",
    "undici": "^8.7.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openai/codex-sdk": "0.153.4",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "8.23.1",
    "@types/tar-stream": "^3.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
