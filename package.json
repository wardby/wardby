{
  "name": "reevo-run",
  "version": "0.0.0",
  "private": true,
  "description": "Schedule and run budget-guarded LLM agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "reevo": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:vendor": "node scripts/build-sandbox-vendor.mjs",
    "build": "npm run build:vendor && tsc -p tsconfig.build.json",
    "prepare": "npm run build:vendor",
    "cli": "tsx src/cli.ts",
    "test": "npm run build:vendor && vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:up": "docker compose -f deploy/local/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/local/docker-compose.yml down",
    "coding:local:up": "docker compose --env-file .env.local -f deploy/local/docker-compose.yml -f deploy/local/docker-compose.phase5.yml up --build -d coding-proxy",
    "coding:local:down": "docker compose --env-file .env.local -f deploy/local/docker-compose.yml -f deploy/local/docker-compose.phase5.yml down",
    "worker:image:local": "node scripts/build-local-coding-worker.mjs",
    "test:phase5": "vitest run src/coding/observability.test.ts src/coding/profile.test.ts src/coding/protocol.test.ts src/providers/coding-proxy/proxy.test.ts src/providers/coding-proxy/secure-fetch.test.ts src/providers/coding-proxy/metering.test.ts src/providers/coding-proxy/runtime.test.ts src/providers/executor/container.test.ts src/providers/jobs/docker.test.ts src/providers/jobs/docker-isolation.test.ts src/providers/jobs/fake.test.ts src/providers/vcs/github.test.ts src/mcp/tools/trigger.test.ts src/core/webhooks.test.ts",
    "test:phase5:database": "vitest run src/coding/schema.database.test.ts src/providers/coding-proxy/prisma-ledger.database.test.ts src/providers/executor/container.database.test.ts src/core/scheduler.test.ts src/mcp/integration.test.ts",
    "verify:phase5": "npm run typecheck && npm run test:phase5 && npm run build && npm run worker:image:policy",
    "test:docker-isolation": "node scripts/docker-isolation-acceptance.mjs",
    "test:docker-job": "node scripts/docker-job-acceptance.mjs",
    "worker:image:policy": "node scripts/coding-worker-image-policy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/client": "^6.19.3",
    "croner": "^10.0.1",
    "dotenv-flow": "^4.1.0",
    "fast-xml-parser": "^5.11.1",
    "gpt-tokenizer": "^2.5.0",
    "jose": "^6.2.12",
    "node-html-parser": "^9.0.3",
    "openai": "^4.67.0",
    "papaparse": "^5.7.0",
    "pino": "^9.14.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openai/codex-sdk": "0.153.4",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "esbuild": "^0.25.12",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.6"
  }
}
