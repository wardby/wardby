# Copy this file to terraform.tfvars and fill in your own values, OR pass
# these as -var flags / a different .tfvars file - this module reads
# variables, it doesn't assume this exact file exists.
#
# Usage pattern A: fork this whole deploy/gcp/ folder into your own repo
# and edit in place.
# Usage pattern B: keep this folder as-is (e.g. as a git submodule or a
# vendored copy) and supply only your own terraform.tfvars alongside it.

project_id = "my-gcp-project-id"
region     = "us-central1"

# Custom domain (requires prior `gcloud domains verify` - see SETUP.md).
# Skip both lines below to deploy without a domain - the service still gets
# a free *.run.app URL (see the cloud_run_service_url output either way).
domain_name           = "wardby.example.com"
create_domain_mapping = true

# Optional overrides (defaults shown):
# name_prefix                 = "wardby"
# min_instance_count          = 2
# max_instance_count          = 10
# cloudsql_tier                = "db-f1-micro"
# cloudsql_availability_type   = "ZONAL"
# cloudsql_deletion_protection = true

container_image = "us-docker.pkg.dev/my-gcp-project-id/wardby/control-plane@sha256:REPLACE_ME"
migration_image = "us-docker.pkg.dev/my-gcp-project-id/wardby/control-plane-migrate@sha256:REPLACE_ME"

# Authentication. The default ("self-hosted") makes wardby its own OAuth
# authorization server, with login keys issued by `wardby auth user create` -
# no external identity system required, which is the quickest way to stand a
# deployment up. Most real deployments instead front an existing IdP:
#
# auth_provider = "delegating"
# auth_issuer   = "https://login.example.com/realms/prod"
# auth_jwks_uri = "https://login.example.com/realms/prod/protocol/openid-connect/certs"
# Optional wardby roles from the IdP (docs/getting-started-identity-provider.md):
# auth_role_claim = "realm_access.roles"
# auth_role_map   = "wardby-admin=admin,wardby-packages=package-approver"
#
# In delegating mode wardby verifies tokens and never issues them, and users are
# administered entirely in your IdP. See SETUP.md for what the IdP must be
# configured to emit.
