# Copy to terraform.tfvars (git-ignored) and fill in. Only the first three are required.

region              = "us-east-1"
hostname            = "wardby.your-company.example"
public_access_cidrs = ["203.0.113.10/32"] # your own address

# name_prefix = "wardby"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"
# additional_admin_principal_arns = ["arn:aws:iam::111122223333:role/your-admin-role"]

# Bring your own VPC (all four, at least two subnets each):
# existing_vpc_id              = "vpc-0123456789abcdef0"
# existing_public_subnet_ids   = ["subnet-...", "subnet-..."]
# existing_private_subnet_ids  = ["subnet-...", "subnet-..."]
# existing_database_subnet_ids = ["subnet-...", "subnet-..."]

# EKS Kubernetes minor version.
# kubernetes_version = "1.36"

# Instance types of the gVisor sandbox node group (x86_64 only).
# sandbox_instance_types = ["m6i.xlarge"]

# RDS instance class.
# database_instance_class = "db.t4g.small"

# "count" only logs the WAF managed body rules; set "block" once the rule groups' CloudWatch metrics and sampled requests look clean.
# waf_managed_rules_action = "count"

# Your own HTTPS mirror of gVisor releases (<base>/<version>/x86_64/gvisor.tar.bz2).
# gvisor_download_base_url = "https://your-mirror.example.com/gvisor/release"

# Run dependency cache (off by default). Creates a private bucket only the
# coding proxy's Pod Identity role can use. Bucket names are global: pick one
# unique to you. Keep max_age_days equal to WARDBY_DEPENDENCY_CACHE_MAX_AGE_DAYS
# (default 14).
# dependency_cache_enabled      = true
# dependency_cache_bucket_name  = "your-unique-dependency-cache-bucket"
# dependency_cache_max_age_days = 14

# Session transcripts for agents with sessionResume (off by default). Creates a
# private bucket only the control plane's Pod Identity role can use -- not the
# dependency cache bucket. Bucket names are global: pick one unique to you. Give
# the control plane RUN_TRANSCRIPT_RETENTION_DAYS equal to retention_days.
# session_transcripts_enabled        = true
# session_transcripts_bucket_name    = "your-unique-session-transcripts-bucket"
# session_transcripts_retention_days = 30
