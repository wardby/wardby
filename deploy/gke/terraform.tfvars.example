# Copy to terraform.tfvars and fill in your own values, OR pass these as -var
# flags / a different .tfvars file -- this module reads variables, it does not
# assume this exact file exists. terraform.tfvars is gitignored; keep it that way.

project_id = "your-project-id"
region     = "us-central1"

# MUST be the network your GKE cluster runs on. A cluster's network is fixed at
# creation and VPC peering is not transitive, so an instance peered into a
# different VPC is simply unreachable from the cluster -- with no error until a
# query times out. Check with:
#
#   gcloud container clusters describe <cluster> --region <region> \
#     --format='value(network)'
#
network = "default"

# db-f1-micro is the cheapest Postgres tier and is adequate for a control plane
# that writes a handful of rows per run. Size up with db-custom-<cpu>-<mb>.
tier              = "db-f1-micro"
availability_type = "ZONAL"
disk_size_gb      = 10

# Set false BEFORE you intend to destroy: the value is read from state, so
# discovering it at destroy time costs an extra apply.
deletion_protection = true

# Secret Manager secrets survive a cluster rebuild and are protected from
# destroy. Set false and apply before `terraform destroy`, like the flags above.
secrets_deletion_protection = true

# REQUIRED refuses connections that bypass the Cloud SQL Auth Proxy. Leave it:
# every workload connects through the Auth Proxy.
connector_enforcement = "REQUIRED"

# Run dependency cache (off by default). Creates a private bucket only the
# coding proxy can use. Bucket names are global: pick one unique to you. Keep
# max_age_days equal to WARDBY_DEPENDENCY_CACHE_MAX_AGE_DAYS (default 14).
# Then deploy with WARDBY_DEPENDENCY_CACHE=true to turn the feature on.
# dependency_cache_enabled      = true
# dependency_cache_bucket_name  = "your-unique-dependency-cache-bucket"
# dependency_cache_max_age_days = 14

# Session transcripts for agents with sessionResume (off by default). Creates a
# private bucket only the control plane can use -- not the dependency cache
# bucket. Bucket names are global: pick one unique to you. The bucket deletes
# transcripts after retention_days, and up.sh passes the same number to the
# control plane. Then deploy with WARDBY_SESSION_TRANSCRIPTS=true.
# session_transcripts_enabled        = true
# session_transcripts_bucket_name    = "your-unique-session-transcripts-bucket"
# session_transcripts_retention_days = 30
