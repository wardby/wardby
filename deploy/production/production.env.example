# Copy to deploy/production/.env.production. This file is deliberately not
# runnable: every image must be a reviewed immutable digest and every secret
# must come from the production secret manager, not from source control.

# Use a public DNS name with no scheme, path, or port.
MCP_PUBLIC_HOST=mcp.example.com
ACME_EMAIL=operations@example.com

# Set both URLs to the same normalized value. Keep the trailing slash.
MCP_CANONICAL_URI=https://mcp.example.com/
AUTH_AUDIENCE=https://mcp.example.com/

# Examples only. Replace every value with an immutable image digest approved by
# the image scanning workflow; never use a mutable tag such as `latest`.
CADDY_IMAGE=registry.example.com/caddy@sha256:REPLACE_WITH_REVIEWED_DIGEST
WARDBY_RUNTIME_IMAGE=registry.example.com/wardby-runtime@sha256:REPLACE_WITH_REVIEWED_DIGEST
WARDBY_MIGRATION_IMAGE=registry.example.com/wardby-migration@sha256:REPLACE_WITH_REVIEWED_DIGEST

# Supply the application database role's TLS connection string. It must be a
# least-privilege role and is used only by mcp and scheduler.
#
# With Prisma 7's node-postgres (`pg`) driver adapter, use
# `sslmode=verify-full`: it validates the server certificate and hostname
# against Node's trusted CA store and rejects the connection if that fails.
# (pg treats `require`, `prefer` and `verify-ca` as aliases for `verify-full`
# and prints a warning about it, so say what you mean.) If the database's certificate chains to a private
# CA that is not in that trust store, add `sslrootcert=<path to the CA
# certificate file, readable by the container>` so pg loads and trusts it. Only
# add `sslmode=no-verify` if you deliberately accept an unverified connection
# (no certificate or hostname check at all) -- never use it to work around an
# untrusted or expired certificate.
DATABASE_URL=postgresql://wardby_app:REPLACE@database.example.com:5432/wardby?sslmode=verify-full
# This separate migration role exists only while the one-off migration profile
# runs. It must not be injected into mcp or scheduler.
#
# This URL is read by the Prisma CLI's schema engine, not by pg, so the
# DATABASE_URL rules above do NOT apply: here `sslmode=require` encrypts but
# does not check the certificate unless you add `sslaccept=strict`; a private
# CA goes in `sslcert=<path to the CA certificate>` (not `sslrootcert=`); and
# `no-verify` is not a valid value.
MIGRATION_DATABASE_URL=postgresql://wardby_migrate:REPLACE@database.example.com:5432/wardby?sslmode=require&sslaccept=strict

# HTTP is mandatory for this stack. The proxy binds the private application
# port; do not change MCP_HTTP_BIND in the Compose file to a public host port.
AUTH_PROVIDER=delegating
AUTH_ISSUER=https://issuer.example.com/
AUTH_JWKS_URI=https://issuer.example.com/.well-known/jwks.json
MCP_ALLOWED_ORIGINS=

# Self-hosted authentication only: use a secret manager and generate these as
# independent values with `openssl rand -hex 32`. Delegating mode does not use
# either key, so leave both empty when AUTH_PROVIDER=delegating.
AUTH_SIGNING_KEY=
AUTH_CREDENTIAL_HASH_KEY=
# Required in both auth modes; inject it through the secret manager.
SECRET_APP_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
REQUEST_STATE_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE

# DBOS is optional. When enabled, mcp and scheduler receive distinct executor
# identities from compose.yml. The database schema must be handled per the
# recovery runbook before enabling it.
EXECUTOR=in-process
DBOS_SYSTEM_DATABASE_URL=
DBOS_SCHEMA=dbos

# The generic stack intentionally never mounts the Docker socket. Enable the
# coding executor only on the separately hardened controller described in
# docs/coding-worker-isolation.md.
JOB_LAUNCHER=local
