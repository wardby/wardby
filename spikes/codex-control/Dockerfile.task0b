FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94

ARG CODEX_VERSION=0.153.4
RUN npm install --global "@openai/codex@${CODEX_VERSION}" \
    && useradd --create-home --uid 10001 wardby

COPY --chmod=0755 wardby-token.sh /usr/local/bin/wardby-token
COPY --chown=wardby:wardby task0b-worker.mjs /opt/wardby/task0b-worker.mjs

USER wardby
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/wardby/task0b-worker.mjs"]
