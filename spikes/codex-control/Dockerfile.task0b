FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94

ARG CODEX_VERSION=0.153.4
RUN npm install --global "@openai/codex@${CODEX_VERSION}" \
    && useradd --create-home --uid 10001 reevo

COPY --chmod=0755 reevo-token.sh /usr/local/bin/reevo-token
COPY --chown=reevo:reevo task0b-worker.mjs /opt/reevo/task0b-worker.mjs

USER reevo
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/reevo/task0b-worker.mjs"]
