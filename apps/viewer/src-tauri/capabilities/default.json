{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The minimum the UI needs: core defaults and this app's own commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-servers",
    "allow-add-server",
    "allow-remove-server",
    "allow-sign-in",
    "allow-cancel-sign-in",
    "allow-sign-out",
    "allow-connect",
    "allow-disconnect",
    "allow-fetch-graph",
    "allow-fetch-run",
    "allow-fetch-infra",
    "allow-fetch-documents",
    "allow-kube-contexts",
    "allow-set-kube-context",
    "allow-kube-connect",
    "allow-kube-disconnect",
    "allow-kube-pod-events",
    "allow-open-url"
  ]
}
