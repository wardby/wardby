            "required": [
              "name",
              "state",
              "attempts",
              "reason",
              "readyAt",
              "failedAt",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "finalText": {
          "type": [
            "string",
            "null"
          ]
        },
        "childRunIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer"
              },
              "at": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "tool",
                  "said"
                ]
              },
              "tool": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "string"
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "seq",
              "at",
              "kind",
              "tool",
              "summary",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "stepsOmitted": {
          "type": "integer"
        },
        "stepsDropped": {
          "type": "integer"
        },
        "request": {
          "description": "Untrusted text: what the run was asked to do (its task from a caller, webhook, issue or lead), without the agent's standing instructions. The agent's secret values and token-shaped values are masked. At most the first 8,000 characters; see requestTruncated. Null when the run has none or it can't be checked for secrets. Absent from servers older than 0.9.6.",
          "type": [
            "string",
            "null"
          ]
        },
        "requestTruncated": {
          "description": "True when request is only the first 8,000 characters of a longer text.",
          "type": "boolean"
        },
        "coding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "repository": {
                  "type": "string"
                },
                "baseRef": {
                  "type": "string"
                },
                "headRef": {
                  "type": "string"
                },
                "queuedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "failureCategory": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      },
                      "image": {
                        "type": "string"
                      },
                      "envNames": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "name",
                      "version",
                      "image",
                      "envNames"
                    ],
                    "additionalProperties": false
                  }
                },
                "repositories": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "access": {
                        "type": "string",
                        "enum": [
                          "read",
                          "write"
                        ]
                      },
                      "repository": {
                        "type": "string"
                      },
                      "requestedRef": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "resolvedSha": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "pullRequestNumber": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "pullRequestUrl": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "resultBranch": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "outcome": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "access",
                      "repository",
                      "requestedRef",
                      "resolvedSha",
                      "pullRequestNumber",
                      "pullRequestUrl",
                      "resultBranch",
                      "outcome"
                    ],
                    "additionalProperties": false
                  },
                  "description": "The other repositories of a multi-repository coding run, in order (the default repository is `repository` above, with its pull request in `result`); empty for a single-repository run. Absent from servers older than the release that added it."
                }
              },
              "required": [
                "provider",
                "repository",
                "baseRef",
                "headRef",
                "queuedAt",
                "failureCategory",
                "services",
                "repositories"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "parentRunId",
        "agentId",
        "agentName",
        "agentKind",
        "model",
        "codingProvider",
        "nativeExecutionMode",
        "warmWorkerName",
        "status",
        "trigger",
        "turns",
        "tokensIn",
        "tokensOut",
        "costUsd",
        "budgetUsd",
        "startedAt",
        "finishedAt",
        "heartbeatAt",
        "outcomes",
        "declaredServices",
        "services",
        "error",
        "finalText",
        "childRunIds",
        "steps",
        "stepsOmitted",
        "stepsDropped",
        "coding"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
