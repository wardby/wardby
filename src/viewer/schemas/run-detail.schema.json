{
  "$ref": "#/definitions/run-detail",
  "definitions": {
    "run-detail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "parentRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentId": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "agentKind": {
          "type": "string",
          "enum": [
            "native",
            "coding"
          ]
        },
        "model": {
          "type": "string"
        },
        "codingProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "nativeExecutionMode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "control-plane",
                "sandbox"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "warmWorkerName": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "refused",
            "lost",
            "budget_exhausted",
            "cancelled"
          ]
        },
        "trigger": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "manual"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "scheduled"
                },
                "schedule": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "schedule"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "webhook"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "subagent"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "code_host"
                },
                "provider": {
                  "type": "string"
                },
                "repository": {
                  "type": "string"
                },
                "number": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "review",
                    "mention"
                  ]
                }
              },
              "required": [
                "kind",
                "provider",
                "repository",
                "number",
                "event"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "issue"
                },
                "provider": {
                  "type": "string"
                },
                "issueKey": {
                  "type": "string"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "provider",
                "issueKey",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "host_event"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "turns": {
          "type": "integer"
        },
        "tokensIn": {
          "type": "integer"
        },
        "tokensOut": {
          "type": "integer"
        },
        "costUsd": {
          "type": "number"
        },
        "budgetUsd": {
          "type": "number"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "heartbeatAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcomes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "pull_request"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "repository": {
                    "type": "string"
                  },
                  "number": {
                    "type": "integer"
                  },
                  "url": {
                    "type": "string"
                  },
                  "state": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "provider",
                  "repository",
                  "number",
                  "url",
                  "state",
                  "at"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "code_host_comment"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "repository": {
                    "type": "string"
                  },
                  "number": {
                    "type": "integer"
                  },
                  "at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "provider",
                  "repository",
                  "number",
                  "at"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "issue_comment"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "issueKey": {
                    "type": "string"
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "provider",
                  "issueKey",
                  "url",
                  "at"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "check"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "repository": {
                    "type": "string"
                  },
                  "number": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "completed": {
                    "type": "boolean"
                  },
                  "at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "provider",
                  "repository",
                  "number",
                  "completed",
                  "at"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "declaredServices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "probing",
                  "ready",
                  "failed"
                ]
              },
              "attempts": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "readyAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "createdAt": {
                "type": "string"
              }
