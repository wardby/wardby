FROM node:24.22.0-bookworm-slim@sha256:91acba91b842bec0bf7ea6f5e09c644c7ccad72c4996ed9616d861d1c7cd60d4 AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json tsconfig.build.json prisma.config.ts ./
COPY prisma ./prisma
COPY scripts ./scripts
COPY help ./help
COPY src ./src
RUN npm run build

FROM node:24.22.0-bookworm-slim@sha256:91acba91b842bec0bf7ea6f5e09c644c7ccad72c4996ed9616d861d1c7cd60d4 AS worker-dependencies
WORKDIR /worker
COPY src/coding-worker/package.json src/coding-worker/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:24.22.0-bookworm-slim@sha256:91acba91b842bec0bf7ea6f5e09c644c7ccad72c4996ed9616d861d1c7cd60d4
LABEL org.opencontainers.image.source="https://github.com/wardby/wardby"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && npm install --global --omit=dev npm@12.0.2 \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin wardby
WORKDIR /opt/wardby
COPY --from=worker-dependencies /worker/node_modules ./node_modules
COPY --from=build /build/dist/coding-worker ./coding-worker
COPY --from=build /build/dist/coding/protocol.js ./coding/protocol.js
# The shared secret redactor (debug-trace.js -> coding/redact.js), which imports
# core/secret-spans.js and coding/protocol.js.
COPY --from=build /build/dist/coding/redact.js ./coding/redact.js
COPY --from=build /build/dist/core/secret-spans.js ./core/secret-spans.js
# The driver's registry-mode setup (driver.js -> coding/registry/worker-config.js)
# and its adapters. Their third-party imports are in src/coding-worker/package.json.
COPY --from=build /build/dist/coding/registry ./coding/registry
# The lockfile normaliser (coding/registry/lockfiles.js) skips the folders collection excludes.
COPY --from=build /build/dist/coding/collect-exclude.js ./coding/collect-exclude.js
# The package-manager shim (npm-shim.mjs), linked as npm, pnpm and yarn:
# verifies a project's lockfile with the registry proxy
# (POST /registry/npm/-/plan) before an install, then runs the real tool
# (pnpm, and a pinned yarn 2+, through corepack). The driver puts
# /opt/wardby/bin first on the agent's PATH; a login shell (bash -l) resets
# PATH from /etc/profile, so profile.d puts it back.
COPY src/coding-worker/npm-shim.mjs ./bin/npm-shim.mjs
RUN chmod 0755 /opt/wardby/bin/npm-shim.mjs \
    && ln -s npm-shim.mjs /opt/wardby/bin/npm \
    && ln -s npm-shim.mjs /opt/wardby/bin/pnpm \
    && ln -s npm-shim.mjs /opt/wardby/bin/yarn \
    && printf '%s\n' 'case ":$PATH:" in *:/opt/wardby/bin:*) ;; *) PATH="/opt/wardby/bin:$PATH" ;; esac' > /etc/profile.d/wardby-shims.sh \
    && PATH="/opt/wardby/bin:$PATH" npm --version \
    && PATH="/opt/wardby/bin:$PATH" yarn --version \
    && test "$(bash -lc 'command -v npm')" = /opt/wardby/bin/npm \
    && test "$(bash -lc 'command -v yarn')" = /opt/wardby/bin/yarn
# The dependency cache (dependency-cache.mjs): restores or installs a run's npm
# dependencies before the agent starts, when the run asks for it. driver.js
# imports it from next to itself; plain JavaScript, so it is copied, not built.
COPY src/coding-worker/dependency-cache.mjs ./coding-worker/dependency-cache.mjs
# `wardby-packages` (wardby-packages.mjs + registry-refusals.mjs): lists the
# package registry's refusals for the run, which pip and uv don't print.
COPY src/coding-worker/registry-refusals.mjs ./coding-worker/registry-refusals.mjs
COPY src/coding-worker/wardby-packages.mjs ./coding-worker/wardby-packages.mjs
# `wardby-packages plan` and the uv shim (uv-shim.mjs + uv-lock.mjs), linked
# as uv: verify a Python lockfile with the registry proxy (pypi-plan.mjs,
# POST /registry/pypi/-/plan) before an install, and point a uv.lock's PyPI
# URLs at the proxy for the command. The real uv is in the node-python image.
COPY src/coding-worker/pypi-plan.mjs ./coding-worker/pypi-plan.mjs
COPY src/coding-worker/uv-lock.mjs ./coding-worker/uv-lock.mjs
COPY src/coding-worker/uv-shim.mjs ./coding-worker/uv-shim.mjs
RUN chmod 0755 /opt/wardby/coding-worker/wardby-packages.mjs /opt/wardby/coding-worker/uv-shim.mjs \
    && ln -s ../coding-worker/wardby-packages.mjs /opt/wardby/bin/wardby-packages \
    && ln -s ../coding-worker/uv-shim.mjs /opt/wardby/bin/uv \
    && test "$(bash -lc 'command -v wardby-packages')" = /opt/wardby/bin/wardby-packages \
    && test "$(bash -lc 'command -v uv')" = /opt/wardby/bin/uv \
    && { /opt/wardby/bin/uv --version 2>&1 || true; } | grep -q "uv is not installed"
# Fail the build, not every run, when a module the worker imports is missing:
# driver-v4 shipped without coding/registry and every run exited at startup
# with ERR_MODULE_NOT_FOUND before the model was called. main.js runs on
# import, so this loads everything it imports rather than main.js itself.
RUN node --input-type=module -e 'await Promise.all(["driver", "sdk", "artifact", "errors", "debug-trace", "skills", "task-note"].map((name) => import(`/opt/wardby/coding-worker/${name}.js`)))' \
    && node --input-type=module -e 'const m = await import("/opt/wardby/coding-worker/dependency-cache.mjs"); if (typeof m.prepareDependencies !== "function") process.exit(1)' \
    && node --input-type=module -e 'const m = await import("/opt/wardby/coding-worker/registry-refusals.mjs"); if (typeof m.recentRefusals !== "function") process.exit(1)' \
    && /opt/wardby/bin/wardby-packages 2>&1 | grep -q "no package registry is configured"
