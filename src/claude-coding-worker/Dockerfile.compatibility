FROM node:24.22.0-bookworm-slim@sha256:91acba91b842bec0bf7ea6f5e09c644c7ccad72c4996ed9616d861d1c7cd60d4

RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap ca-certificates git socat \
    && npm install --global --omit=dev npm@12.0.2 \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin wardby

WORKDIR /opt/wardby/claude-compatibility
COPY src/claude-coding-worker/package.json src/claude-coding-worker/package-lock.json ./
RUN npm ci --ignore-scripts \
    && npm cache clean --force
COPY src/claude-coding-worker/compatibility.test.mjs ./
# The real sanitiser source (erasable TypeScript, no imports); Node strips the types itself.
COPY src/coding/transcript/claude-code.ts ./transcript/claude-code.ts

USER 10001:10001
ENV NODE_ENV=production HOME=/home/wardby
ENTRYPOINT ["npm", "run", "test:compatibility"]
