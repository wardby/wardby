{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    // rootDir "." takes in tools/**; with it, the "#prisma" import map no longer maps
    // dist/ back to src/, so resolve its "wardby-source" condition (as vitest does).
    "rootDir": ".",
    "customConditions": ["wardby-source"],
    "outDir": "dist"
  },
  // tools/** (the wardby-sim test simulator) is type-checked here but never built:
  // tsconfig.build.json narrows include and sets rootDir to src.
  "include": ["src/**/*.ts", "tools/**/*.ts"]
}
