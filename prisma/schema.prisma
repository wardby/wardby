// Hand-written per CLEANROOM.md — never generated from another project's
// schema. Targets PostgreSQL even for the laptop demo; "portable" means any
// Postgres (see deploy/local/docker-compose.yml), not a cloud dependency.

// Generated into src/generated/prisma (gitignored; `npm run build` and
// `prepare` regenerate it) and imported everywhere as "#prisma" (package.json
// "imports"). Pure TS + wasm query compiler: no native engine, so the built
// client is portable across platforms.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// The connection URL lives in prisma.config.ts (CLI) and src/core/db.ts
// (runtime, through @prisma/adapter-pg).
datasource db {
  provider = "postgresql"
}

model Agent {
  id            String              @id @default(cuid())
  name          String              @unique
  systemPrompt  String
  model         String
  budgetUsd     Decimal             @db.Decimal(10, 4)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  runs          Run[]
  kind          AgentKind           @default(native)
  codingProfile CodingAgentProfile?

  // Phase 2: scheduling. `schedule` is a cron expression; null = manual-only.
  schedule        String?
  timezone        String    @default("UTC")
  scheduleEnabled Boolean   @default(true)
  /// Start of the most recent due window this agent was fired for.
  lastScheduledAt DateTime?

  // Phase 3: tools + multi-turn loop.
  tools                AgentTool[]
  maxTurns             Int         @default(10)
  /// Sub-agent delegations one run may make (delegate_to_*), each to a different sub-agent. 1 = route to exactly one.
  maxDelegationsPerRun Int         @default(1)
  /// Native leads: the delegate_to_* calls of one model turn run at the same time. False = one after another.
  parallelDelegations  Boolean     @default(false)

  // Phase 4: ownership. Null = owner-less, a transition state only: access
  // then comes from ResourceGrant rows alone (the migration gives everyone
  // execute), and `wardby grants adopt-public` assigns an owner. See
  // ResourceGrant.
  ownerId              String?
  owner                Principal?            @relation(fields: [ownerId], references: [id])
  secrets              AgentSecret[]
  datastores           AgentDatastore[]
  webhooks             Webhook[]
  repositories         AgentRepository[]
  deferredReviews      DeferredReview[]
  issueProjects        AgentIssueProject[]
  notificationChannels NotificationChannel[]

  /// Self-defects opt-in: the Jira project and issue type wardby files the agent's own failures into. Both or neither.
  defectProjectKey String?
  defectIssueType  String?

  // Phase 7: at most one budget group. Null = uncapped beyond its own budgetUsd.
  budgetGroupId String?
  budgetGroup   BudgetGroup? @relation(fields: [budgetGroupId], references: [id])

  /// Un-phased: gates the memory_get/memory_set/memory_list/memory_search
  /// built-in tools (see AgentMemory below). Off by default — a memory-less
  /// agent sees no memory tools at all, and no AgentMemory rows are ever
  /// created for it.
  memoryEnabled Boolean @default(false)

  /// Un-phased: reasoning effort for native agents (low, medium, high,
  /// xhigh, max). Validated against the model in code, not a DB enum.
  /// Null = the provider's default.
  effort String?

  /// Native agents only: where their runs execute. control-plane (default) =
  /// in this server process (in-process or DBOS); sandbox = an isolated,
  /// single-use worker container/pod. Each Run snapshots this at creation
  /// (Run.nativeExecutionMode), so a change reaches only later runs.
  nativeExecutionMode NativeExecutionMode @default(control_plane)

  /// Un-phased: sub-agent composition edges (see AgentSubAgent below). An
  /// agent can be a parent (has children it can delegate to) and/or a
  /// child (is delegated to by others) independently.
  subAgentEdgesAsParent AgentSubAgent[] @relation("SubAgentParent")
  subAgentEdgesAsChild  AgentSubAgent[] @relation("SubAgentChild")
}

/// Un-phased: agent-composition edge, referenced by agent name at the
/// import boundary (capabilities/subagents.json) but id-based here to
/// match that Tier-1 convention. Cycle-checked in the MCP tool handler at
/// creation time, not enforced by the database (Postgres has no native
/// "no cycles" constraint).
model AgentSubAgent {
  parentAgentId String
  childAgentId  String
  /// Local name the parent's dispatch tool is exposed under
  /// (delegate_to_<boundName>) — decoupled from the child's own possibly-
  /// renamed Agent.name, same convention as AgentDatastore.boundName.
  boundName     String
  parent        Agent  @relation("SubAgentParent", fields: [parentAgentId], references: [id], onDelete: Cascade)
  child         Agent  @relation("SubAgentChild", fields: [childAgentId], references: [id], onDelete: Cascade)

  @@id([parentAgentId, childAgentId])
  @@unique([parentAgentId, boundName])
}

/// Phase 7: an optional recurring spend cap across a group of agents,
/// layered on top of each agent's own per-run budgetUsd (which stays
/// required and unchanged). All three period caps are independently
/// optional -- unset means "no cap for that period." warnThresholdRatio
/// is per-group so different groups can choose their own early-warning
/// point; enforcement itself never lives here -- see
/// src/core/budget-groups.ts and runner.ts's executeRun, which turn a
/// group's remaining period budget into a tightened *effective* per-run
/// budget the existing engine budget machinery enforces unchanged.
model BudgetGroup {
  id                 String     @id @default(cuid())
  name               String
  ownerId            String?
  owner              Principal? @relation(fields: [ownerId], references: [id])
  dailyBudgetUsd     Decimal?   @db.Decimal(10, 4)
  weeklyBudgetUsd    Decimal?   @db.Decimal(10, 4)
  monthlyBudgetUsd   Decimal?   @db.Decimal(10, 4)
  warnThresholdRatio Decimal    @default(0.8) @db.Decimal(3, 2)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  agents             Agent[]

  @@unique([ownerId, name])
}

enum AgentKind {
  native
  coding
}

/// Where a native agent's runs execute (Agent.nativeExecutionMode).
enum NativeExecutionMode {
  control_plane @map("control-plane")
  sandbox
}

enum RunStatus {
  pending
  running
  succeeded
  failed
  refused
  /// Phase 2: orphaned by a dead executor, recovered by the reconciler.
  lost
  /// Phase 3: budget ran out mid-loop; graceful wind-down (or hard-stop)
  /// already applied. Distinct from `refused` (turn-1, zero spend) and
  /// `failed` (an actual error).
  budget_exhausted
  /// Phase 5: explicitly stopped by an authenticated caller.
  cancelled
}

/// Phase 3: a WASM-sandboxed, Zod-validated tool a model can call.
model Tool {
  id          String      @id @default(cuid())
  /// Unique per owner (@@unique below), not globally: the name is what the
  /// model calls, so what must never repeat is a name within one agent's
  /// attachments — attach_tool, `wardby tool attach` and the importer refuse
  /// a second same-named tool on an agent.
  name        String
  description String
  /// Zod schema *source text*; compiled and evaluated inside the sandbox,
  /// never in the host process.
  paramsZod   String
  /// JSON Schema derived from paramsZod at registration time (deriveJsonSchema)
  /// and cached here — re-deriving it on every run would spin a fresh QuickJS
  /// runtime and evaluate the whole vendored zod bundle per attached tool,
  /// before the first LLM call, on every single run. Safe to cache because
  /// every write of paramsZod (create, and MCP update_tool) re-derives it in
  /// the same write. A run pins the version its load step read.
  jsonSchema  Json
  /// Tool body source; run inside the sandbox with the validated params.
  code        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  agents      AgentTool[]

  // Phase 4: ownership. Null = owner-less (a transition state; tool grants
  // arrive in the resource-sharing grants Phase 2, see ResourceGrant).
  ownerId String?
  owner   Principal? @relation(fields: [ownerId], references: [id])

  @@unique([ownerId, name])
}

/// Phase 3: explicit many-to-many join between Agent and Tool.
/// Phase 6: per-attachment capability scoping (OWASP LLM08 fix — Excessive
/// Agency). Empty array = no access to that resource class; a tool must be
/// explicitly granted secrets/datastore-prefixes/hosts at attach time. A
/// literal "*" element in allowedHosts lifts the fetch allowlist entirely
/// (existing SSRF protection against private/link-local addresses still
/// applies) — the back-compat escape hatch for pre-existing attachments and
/// deliberate full-web-access tools. See src/sandbox/tool-capabilities.ts.
model AgentTool {
  agentId String
  toolId  String
  agent   Agent  @relation(fields: [agentId], references: [id])
  tool    Tool   @relation(fields: [toolId], references: [id])

  allowedSecrets                 Json @default("[]")
  allowedDatastorePrefixes       Json @default("[]")
  allowedHosts                   Json @default("[]")
  allowedSharedDatastorePrefixes Json @default("{}")

  /// Who created the attachment. Audit only: plain text, no FK (same
  /// convention as AgentRepository.authorizedById).
  attachedById            String?
  /// The principal whose consent the four capability fields above carry.
  /// The runner honours them only while this equals the agent's CURRENT
  /// ownerId (resource-sharing grants spec §3.4.2): a write-grantee's
  /// attachment, a make_owner transfer, or a pre-grants row nobody vouched
  /// for runs with no secrets, no datastore and no fetch until the owner
  /// re-grants with attach_tool. Plain text, no FK.
  capabilitiesGrantedById String?

  @@id([agentId, toolId])
}

/// Named, owned resource shared across agents via AgentDatastore (Un-phased
/// roadmap item "Named / shared datastores"). Null ownerId = public/unowned,
/// matching Tool's convention.
model Datastore {
  id        String           @id @default(cuid())
  name      String
  ownerId   String?
  owner     Principal?       @relation(fields: [ownerId], references: [id])
  agents    AgentDatastore[]
  entries   DatastoreEntry[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([ownerId, name])
}

/// Attaches a Datastore to an agent, addressed at sandbox point-of-use by
/// `boundName` (sharedDatastore.get(boundName, key)) — same boundName
/// convention as AgentSecret. Defaults to the datastore's own name.
model AgentDatastore {
  agentId     String
  datastoreId String
  boundName   String
  agent       Agent     @relation(fields: [agentId], references: [id])
  datastore   Datastore @relation(fields: [datastoreId], references: [id])

  @@id([agentId, datastoreId])
  @@unique([agentId, boundName])
}

/// Phase 3: the datastore seam's Postgres-backed default. Scoped by agentId
/// (private, per-agent) or datastoreId (shared, see Datastore above) — a row
/// carries exactly one, enforced by a hand-written CHECK in the migration
/// (Prisma has no declarative "exactly one of two columns" constraint).
/// Phase 6: optional per-entry PII encryption (see `pii`/`keyId` below).
///
/// `id` is a surrogate key required by Prisma's schema validator: with
/// agentId and datastoreId both optional, neither `@@unique` below has an
/// all-required-fields criterion, and Prisma rejects a model with no such
/// criterion (P1012, "Each model must have at least one unique criteria
/// that has only required fields") — `prisma generate`/`validate` refuse to
/// run at all without it. Point lookups still go through the
/// agentId_key/datastoreId_key compound uniques; `id` is not otherwise used.
model DatastoreEntry {
  id          String     @id @default(cuid())
  agentId     String?
  datastoreId String?
  key         String
  value       Json
  pii         Boolean    @default(false)
  keyId       String?
  updatedAt   DateTime   @updatedAt
  // onDelete: Restrict is explicit (Prisma's inferred default for an
  // optional relation is SetNull) because the migration's FK is RESTRICT:
  // nulling datastoreId on delete would leave both agentId and datastoreId
  // null, violating the DatastoreEntry_scope_xor CHECK above.
  datastore   Datastore? @relation(fields: [datastoreId], references: [id], onDelete: Restrict)

  @@unique([agentId, key])
  @@unique([datastoreId, key])
}

/// Un-phased: agent-controlled persistent memory (key/content per agent),
/// gated by Agent.memoryEnabled. Deliberately a separate table rather than a
/// Datastore convention — memory has its own access surface (built-in
/// memory_get/memory_set/memory_list/memory_search tools, not user-authored
/// sandbox code) and its own full-text search index, which would be an odd
/// fit bolted onto Datastore's opaque-JSON-value shape. No FK to Agent,
/// matching DatastoreEntry: deleting an agent leaves orphaned rows today,
/// same pre-existing gap, not a new one.
///
/// `contentTsv` is maintained by application code (see
/// PostgresAgentMemory.set), never a Postgres GENERATED column — a generated
/// column's expression has no representation in `Unsupported()`, which risks
/// the migration-vs-schema drift check (CLAUDE.md) never landing clean.
model AgentMemory {
  agentId    String
  key        String
  content    String
  contentTsv Unsupported("tsvector")?
  updatedAt  DateTime                 @updatedAt

  @@id([agentId, key])
  @@index([contentTsv], type: Gin)
}

/// Phase 2: how a Run was created.
enum RunTrigger {
  manual
  scheduled
  webhook
  subagent
  host_event
}

model Run {
  id                   String                   @id @default(cuid())
  agent                Agent                    @relation(fields: [agentId], references: [id])
  agentId              String
  status               RunStatus                @default(pending)
  trigger              RunTrigger               @default(manual)
  tokensIn             Int                      @default(0)
  tokensOut            Int                      @default(0)
  costUsd              Decimal                  @default(0) @db.Decimal(10, 6)
  error                String?
  startedAt            DateTime                 @default(now())
  finishedAt           DateTime?
  /// Phase 2: beaten by the executor while running; a stale value past
  /// HEARTBEAT_TIMEOUT is how the reconciler finds an orphaned run.
  heartbeatAt          DateTime?
  /// Phase 4: EngineResult.finalText, persisted so a Task (MCP) or later
  /// inspection can read a completed run's answer. Previously only ever
  /// streamed live via onText and dropped — no durable place to read it
  /// from until this field existed.
  finalText            String?
  /// Phase 4: EngineResult.turns, persisted for the same reason as
  /// finalText — MCP's list_runs/get_run need it and it was previously
  /// dropped after the engine returned.
  turns                Int                      @default(0)
  /// The run's model catalog entry, recorded when it started (native: the
  /// runner's load step; coding: dispatch). The run is billed at these rates
  /// for its whole life, resumes included. Null on runs from before the
  /// model catalog.
  pricingVersion       String?
  pricingSnapshot      Json?
  /// Detached executors are recovered by handle rather than inferred from trigger.
  executionManaged     Boolean                  @default(false)
  /// Phase 6: which durable executor backend holds this run, if any
  /// ("dbos" = a DBOS workflow whose id equals this run's id). Null for
  /// in-process runs. The reconciler consults the backend before declaring a
  /// stale run lost, and can adopt one orphaned by a dead instance.
  executionBackend     String?
  /// The agent's nativeExecutionMode when this run was created, fixed for the
  /// run's life and what the executor routes on. Null for coding runs and for
  /// native runs from before the field existed, which run in the control plane.
  nativeExecutionMode  NativeExecutionMode?
  codingRun            CodingRun?
  hostCheck            RunHostCheck?
  hostStatus           RunHostStatus?
  issueStatus          RunIssueStatus?
  attribution          RunAttribution?
  modelUsage           RunModelUsage[]
  serviceStatuses      CodingRunServiceStatus[]
  /// A manual review of a local branch: this run is the review run dispatched for it.
  localPullRequest     LocalPullRequest?
  /// A sandbox-mode native run's gateway session (native sandbox phase 3).
  nativeGatewaySession NativeGatewaySession?
  /// The warm pool worker this sandbox-mode run claimed (native sandbox phase 6).
  nativeWarmWorker     NativeWarmWorker?
  /// Set when a process that may not start runs itself (the native sandbox
  /// gateway, which holds no executor) dispatched this run: the scheduler
  /// leader starts it through the server's executor and clears this.
  startDeferredAt      DateTime?
  /// Likewise a stop that process asked for: the scheduler leader stops the
  /// run through the server's executor and clears this.
  stopRequestedAt      DateTime?
  stopRequestReason    String?

  /// Un-phased: sub-agent dispatch (see AgentSubAgent). Null for a
  /// top-level run; set when this run was created by a parent run's
  /// delegate_to_<boundName> tool call. The run tree rooted at the
  /// top-level ancestor shares one real-time budget scope (see
  /// src/core/budget-groups.ts's pattern, generalized from BudgetGroup
  /// membership to this tree).
  parentRunId             String?
  parentRun               Run?     @relation("RunTree", fields: [parentRunId], references: [id])
  childRuns               Run[]    @relation("RunTree")
  /// Ephemeral, per-dispatch grant: exactly the parent-memory keys this
  /// one child run was handed permission to read via parent_memory_get.
  /// Never a standing allowlist — re-granted on every dispatch call.
  grantedParentMemoryKeys String[] @default([])
  /// Per-run task text for a native agent, which otherwise has no
  /// per-invocation input at all (only its fixed systemPrompt). Set only by
  /// delegate_to_<boundName> dispatch today — never exposed as a public
  /// trigger_agent/webhook parameter for native agents, unlike coding
  /// agents' CodingTaskOverrideSchema. Appended (never prepended) to the
  /// loaded systemPrompt at run time so the stable prefix stays
  /// prompt-cache-eligible across dispatches.
  taskOverride            String?
  /// The principal the run is visible to besides the agent's owner
  /// (resource-sharing grants spec §3.5): the trigger_agent caller, a
  /// webhook's creator, or a sub-agent's parent run's triggerer. Null for
  /// scheduled, host-event and CLI runs, which only the owner sees. Plain
  /// text, no FK.
  triggeredById           String?

  @@index([agentId, triggeredById])
  /// The admin viewer's graph window (runs started since a time, or still
  /// pending/running) and its ancestor/children walks (docs/viewer-api.md).
  @@index([startedAt])
  @@index([status])
  @@index([parentRunId])
  @@index([startDeferredAt])
  @@index([stopRequestedAt])
}

/// Phase 5: owner-configured coding behavior. Runtime credentials and opaque
/// launcher handles never live on the reusable profile.
model CodingAgentProfile {
  agentId                  String    @id
  agent                    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider                 String    @default("codex")
  repository               String
  baseRef                  String    @default("main")
  defaultTask              String?
  allowWebhookTaskOverride Boolean   @default(false)
  timeoutSec               Int       @default(1800)
  /// Claude Code runs only: the most agent turns a run may take. Null = the worker default (200).
  maxTurns                 Int?
  /// Unused; dropped after rollout (see the package-registry plan, Task 14).
  allowedEgress            Json      @default("[]")
  protectedPaths           Json
  collectExclude           Json      @default("[]")
  toolchain                String    @default("node")
  toolchainVersion         String?
  workerImageRef           String?
  /// Per-agent workspace size in MiB; null = CODING_DISK_MB.
  workspaceDiskMb          Int?
  packageAllowlist         Json      @default("{}")
  packagePolicy            Json      @default("{}")
  /// Admin-requested debug trace: while now < debugTraceUntil, every coding
  /// run of this agent is dispatched with CodingRun.debugTrace set. Null = off.
  debugTraceUntil          DateTime?
  /// Coding-run services (docs/coding-services.md): the catalog names
  /// (CodingService.name) this agent's runs may start, any version the catalog
  /// has. Empty = none. Owner-set through update_agent.
  services                 Json      @default("[]")

  /// How `repository` was authorized for this agent (see AgentRepository.authorizedVia):
  /// "host_permission", "admin", or "grandfathered". Null = never authorized; runs are refused.
  repositoryAuthorizedVia  String?
  /// The principal whose GitHub access (or admin approval) authorized it. Audit only, no FK.
  repositoryAuthorizedById String?
  repositoryAuthorizedAt   DateTime?
}

/// Phase 5: immutable dispatch inputs plus opaque execution/result state for
/// one coding run. Policy is copied from the profile before work starts.
model CodingRun {
  runId             String              @id
  run               Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  task              String
  repository        String
  baseRef           String
  headRef           String
  provider          String
  model             String
  timeoutSec        Int
  /// Unused; dropped after rollout (see the package-registry plan, Task 14).
  allowedEgress     Json                @default("[]")
  protectedPaths    Json
  collectExclude    Json                @default("[]")
  jobBackend        String?
  jobHandle         String?
  result            Json?
  resultSchema      Int                 @default(1)
  /// Sanitized terminal classification and an opaque log correlation reference.
  /// Neither field may contain task, repository, environment, or credential data.
  failureCategory   String?
  diagnosticId      String?
  workerImage       String?
  /// Claude Code's tool-runner image, resolved from the agent's toolchain at dispatch; null for Codex runs.
  toolImage         String?
  budgetReservedUsd Decimal             @db.Decimal(10, 6)
  /// Phase 12 concurrency queue: set when start() found every coding slot
  /// taken (CODING_MAX_CONCURRENT), cleared when the run claims a slot. A
  /// pending run with queuedAt set is waiting, not orphaned.
  queuedAt          DateTime?
  /// Per-agent workspace size in MiB; null = CODING_DISK_MB.
  workspaceDiskMb   Int?
  packageAllowlist  Json                @default("{}")
  packagePolicy     Json                @default("{}")
  /// Fixed at dispatch from the profile's debugTraceUntil: the worker writes a
  /// full stream trace to its own pod log (never to the database).
  debugTrace        Boolean             @default(false)
  /// Fixed at dispatch from the profile's maxTurns: the Claude Code worker's turn limit. Null = the worker default.
  maxTurns          Int?
  /// Coding-run services resolved at dispatch from the base branch's
  /// .wardby/services.yaml: one snapshot per service (the catalog entry minus
  /// kind), fixed for the run's lifetime. Empty = none.
  services          Json                @default("[]")
  /// The originating tracker issue ("jira" + key), set by the control plane from the run tree, never from model output.
  issueProvider     String?
  issueKey          String?
  /// The branch a run pushed to a local repository (no pull request exists); null otherwise.
  resultBranch      String?
  /// The commit the run started from (the base ref's tip when the workspace was prepared).
  baseSha           String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  proxySession      CodingProxySession?

  /// Revision-in-place for continuing an existing coding pull request.
  /// Points directly at the ROOT CodingRun that actually owns the branch/PR
  /// this run's headRef reuses -- never a chain to "whichever run
  /// immediately preceded this one." Deliberately not restricted to the
  /// same agent: a plan run's PR can be continued by an implement run on
  /// the same branch. Null means this run owns its own fresh branch/PR.
  rootCodingRunId String?
  rootCodingRun   CodingRun?  @relation("CodingRunContinuation", fields: [rootCodingRunId], references: [runId])
  continuations   CodingRun[] @relation("CodingRunContinuation")

  registryAllowances       RegistryAllowance[]
  registryFetches          RegistryFetch[]
  registryApprovedVersions RegistryApprovedVersion[]
  registryPlanRefusals     RegistryPlanRefusal[]

  @@index([jobBackend, jobHandle])
  @@index([failureCategory])
  @@index([queuedAt])
  @@index([rootCodingRunId])
}

/// Coding-run services (docs/coding-services.md): the catalog a repository's
/// .wardby/services.yaml names entries from. Admin-managed over MCP
/// (list/get_service: agents:read; create/update/delete_service:
/// services:manage, audit-logged).
/// Built-in rows ship with wardby, seeded by migration, and change only with a
/// wardby release. `kind` is "sidecar" (a fresh instance in each run's pod);
/// "external" is reserved.
model CodingService {
  id            String   @id @default(cuid())
  name          String
  version       String
  kind          String   @default("sidecar")
  /// Digest-pinned image reference (repo@sha256:...).
  image         String
  port          Int
  /// Environment for the service container itself: throwaway per-run values, never secrets.
  serviceEnv    Json     @default("{}")
  /// Variables the agent's shells receive (DATABASE_URL, PG*, REDIS_URL, ...).
  testEnv       Json     @default("{}")
  /// { command, periodSeconds, timeoutSeconds, failureThreshold }: the sidecar's startup probe.
  readiness     Json
  /// { cpuMillicores, memoryMib, diskMib }: requests equal limits.
  resources     Json
  /// Where the service writes its data: an emptyDir in the run pod.
  dataPath      String
  /// Further directories the image writes to (socket directory, /tmp): each an emptyDir.
  writablePaths Json     @default("[]")
  builtin       Boolean  @default(false)
  /// The admin who created it. Audit only, no FK; null for built-ins.
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name, version])
}

enum CodingServiceState {
  pending
  probing
  ready
  failed
}

/// Live start-up state of one coding-run service (one row per run x
/// service), written by the job launcher as it observes the service, for
/// display only (the viewer). The run's CodingRun.services
/// snapshot says what was started; this says how far each one got.
/// `attempts` is the readiness probes made so far, known only where wardby
/// runs the probe itself (Docker); `reason` is a fixed identifier
/// (image_unavailable, start_failed, exited, probe_failed, timed_out),
/// never probe output.
model CodingRunServiceStatus {
  id        String             @id @default(cuid())
  runId     String
  run       Run                @relation(fields: [runId], references: [id], onDelete: Cascade)
  name      String
  state     CodingServiceState @default(pending)
  attempts  Int?
  reason    String?
  readyAt   DateTime?
  failedAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([runId, name])
}

enum CodingProxySessionStatus {
  active
  cancelled
}

enum CodingProxyRequestStatus {
  reserved
  completed
  released
  uncertain
}

enum NativeGatewaySessionStatus {
  active
  finished
  cancelled
}

enum NativeWarmWorkerStatus {
  warming
  idle
  claimed
  retiring
}

enum NativeGatewayCallStatus {
  reserved
  completed
  released
  uncertain
  pending
  waiting_budget
}

/// The trusted gateway's record of one sandbox-mode native run (native
/// sandbox phase 3): the worker authenticates with a capability whose hash is
/// stored here (the raw token is never persisted), and any control-plane
/// replica can serve it from this row. `snapshot` is what the run loaded --
/// the worker's input plus trusted-only capabilities and links -- and never
/// holds a secret value.
model NativeGatewaySession {
  id                String                     @id @default(cuid())
  runId             String                     @unique
  run               Run                        @relation(fields: [runId], references: [id], onDelete: Cascade)
  capabilityHash    String                     @unique
  status            NativeGatewaySessionStatus @default(active)
  deadlineAt        DateTime
  budgetUsd         Decimal                    @db.Decimal(18, 10)
  snapshot          Json
  /// Set the first time the gateway refuses a model call for budget.
  budgetExhaustedAt DateTime?
  /// When the worker's network isolation was proven (a Kubernetes run's in-pod
  /// probe; a Docker run's network exists before its container). The gateway
  /// serves nothing before this is set.
  networkReadyAt    DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  calls             NativeGatewayCall[]

  /// NATIVE_SANDBOX_MAX_CONCURRENT counts the active sessions on every start.
  @@index([status])
}

/// One worker of the native sandbox warm pool (native sandbox phase 6): an
/// isolated worker started before any run exists, holding no run data or
/// capability. A run claims an idle one with a compare-and-swap on this row
/// (`runId` is set at the claim), its input is delivered only after, and the
/// worker is destroyed after that one run. The row is inserted before the
/// worker is created, so a worker with no row is an orphan.
model NativeWarmWorker {
  /// The worker's random token; its container or pod name carries it.
  id        String                 @id
  name      String                 @unique
  status    NativeWarmWorkerStatus @default(warming)
  /// What the worker was built from (image, limits, isolation settings): a
  /// claim only takes a worker of the current spec.
  specHash  String
  runId     String?                @unique
  run       Run?                   @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// When its isolation was proven and it became claimable.
  readyAt   DateTime?
  claimedAt DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([status, specHash])
}

/// One worker call through the gateway, keyed by its callId: model calls are
/// reserved before the provider is called and settled after; side-effecting
/// built-in and bridge calls keep their result so a retried callId replays it;
/// a delegation records the child run it started.
model NativeGatewayCall {
  id                String                  @id @default(cuid())
  sessionId         String
  session           NativeGatewaySession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  callId            String
  method            String
  status            NativeGatewayCallStatus
  reservationUsd    Decimal?                @db.Decimal(18, 10)
  actualCostUsd     Decimal?                @db.Decimal(18, 10)
  inputTokens       Int?
  outputTokens      Int?
  cachedInputTokens Int?
  cacheWriteTokens  Int?
  /// A replayable result. Never a secret value.
  result            Json?
  childRunId        String?
  /// A delegation's sub-agent, recorded at admission (it holds a place while waiting for budget).
  childAgentId      String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  completedAt       DateTime?

  @@unique([sessionId, callId])
  @@index([sessionId, status])
}

/// Trusted-boundary state for one coding run. Only a capability digest and an
/// upstream credential reference are persisted; neither secret value enters the DB.
model CodingProxySession {
  id                String                   @id @default(cuid())
  runId             String                   @unique
  run               CodingRun                @relation(fields: [runId], references: [runId], onDelete: Cascade)
  capabilityHash    String                   @unique
  credentialRef     String
  protocol          String                   @default("openai-responses")
  allowedModels     Json
  deadlineAt        DateTime
  budgetUsd         Decimal                  @db.Decimal(18, 10)
  status            CodingProxySessionStatus @default(active)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  requests          CodingProxyRequest[]
  /// Hash of the derived registry-only token (see deriveRegistryToken); the
  /// token itself is never persisted.
  registryTokenHash String?                  @unique
  /// Set the first time the proxy refuses a request of this session for
  /// budget; lets the executor report the run as out of budget.
  budgetExhaustedAt DateTime?
  /// The upstream error code (a fixed identifier, never a message) of the
  /// first provider failure the proxy relayed for this session; lets the
  /// executor say the model provider refused the run.
  upstreamFailure   String?
  /// The run's catalog entry, copied from Run.pricingSnapshot when the session
  /// is created; the proxy prices and shapes requests from it. Null on
  /// sessions from before the model catalog (the proxy falls back to the
  /// shipped catalog).
  pricingVersion    String?
  catalogEntry      Json?

  @@index([deadlineAt])
}

/// Monotonic per-upstream-call ledger. Uncertain reservations remain held so a
/// crash or truncated provider stream can never create new spendable budget.
model CodingProxyRequest {
  id                 String                   @id @default(cuid())
  sessionId          String
  session            CodingProxySession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestKey         String
  requestFingerprint String
  model              String
  status             CodingProxyRequestStatus @default(reserved)
  reservationUsd     Decimal                  @db.Decimal(18, 10)
  actualCostUsd      Decimal?                 @db.Decimal(18, 10)
  pricingVersion     String
  pricingSnapshot    Json
  inputTokens        Int?
  outputTokens       Int?
  cachedInputTokens  Int?
  cacheWriteTokens   Int?
  reasoningTokens    Int?
  upstreamStatus     Int?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  completedAt        DateTime?

  @@unique([sessionId, requestKey])
  @@index([sessionId, status])
}

enum RegistryFetchOutcome {
  served
  refused
}

/// One package a run's profile has approved from a given ecosystem, resolved
/// once at dispatch (see CodingRun.packageAllowlist) and used to gate every
/// proxy fetch for the run's lifetime.
model RegistryAllowance {
  runId     String
  ecosystem String
  name      String
  createdAt DateTime  @default(now())
  run       CodingRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@id([runId, ecosystem, name])
}

/// Audit ledger of every package fetch the registry proxy served or refused
/// for a run.
model RegistryFetch {
  id        String               @id @default(cuid())
  runId     String
  ecosystem String
  name      String
  version   String?
  filename  String?
  integrity String?
  sizeBytes Int?
  outcome   RegistryFetchOutcome
  reason    String?
  createdAt DateTime             @default(now())
  run       CodingRun            @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId, createdAt])
}

/// Immutable facts about one published package version, read from the
/// registry itself (never from a lockfile) by lockfile verification: its
/// publish time, integrity, download URL and declared dependencies
/// ([{ key, name, range }], aliases resolved). Stored once and reused
/// forever; allow/deny decisions are never cached here.
model RegistryVersionFact {
  ecosystem    String
  name         String
  version      String
  publishedAt  DateTime
  integrity    String
  downloadUrl  String
  dependencies Json
  createdAt    DateTime @default(now())

  @@id([ecosystem, name, version])
}

/// One exact package version a run's lockfile plan (POST
/// /registry/<ecosystem>/-/plan) verified and approved: a download of it is
/// served directly, integrity-checked against this value.
model RegistryApprovedVersion {
  runId     String
  ecosystem String
  name      String
  version   String
  integrity String
  createdAt DateTime  @default(now())
  run       CodingRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@id([runId, ecosystem, name, version])
}

/// One exact package version a run's lockfile plan refused for a reason
/// intrinsic to the registry's name@version (too new, an advisory, not
/// published, no integrity, hosted elsewhere): a download of it is answered
/// from here with the same code and reason, without a graph walk.
model RegistryPlanRefusal {
  runId       String
  ecosystem   String
  name        String
  version     String
  code        String
  reason      String
  /// Set for a too-new refusal: the answer re-checks the version's age
  /// against the run's cutoff at answer time, so the refusal lapses.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  run         CodingRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@id([runId, ecosystem, name, version])
}

/// Phase 2: single-row-per-scope lease so exactly one scheduler process
/// ticks at a time. `holder` is a process instance id (crypto.randomUUID()).
model SchedulerLease {
  scope     String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

/// Phase 4: an authenticated caller. `subject` is the IdP subject claim
/// (delegating mode) or the configured LOCAL_PRINCIPAL (stdio, no token).
/// Created on first sight (find-or-create by subject).
model Principal {
  id           String        @id @default(cuid())
  subject      String        @unique
  createdAt    DateTime      @default(now())
  agents       Agent[]
  tools        Tool[]
  secrets      Secret[]
  datastores   Datastore[]
  webhooks     Webhook[]
  authUser     AuthUser?
  budgetGroups BudgetGroup[]

  hostIdentities           HostIdentity[]
  hostIdentityLinkRequests HostIdentityLinkRequest[]
  grants                   ResourceGrant[]
}

/// Explicit sharing of one resource with one grantee (docs/private/
/// 2026-09-26-resource-sharing-grants-spec-and-plan.md). Polymorphic on
/// (resourceType, resourceId) -- no FK to the resource, so every resource
/// delete path removes its grants in the same transaction. Levels are
/// ordered per type and validated in code (core/grants.ts), like
/// AgentRepository.provider, so a new type or level needs no enum migration.
model ResourceGrant {
  id                 String     @id @default(cuid())
  /// "agent" | "tool" | "budget_group" (later "secret" | "datastore").
  resourceType       String
  resourceId         String
  /// "principal" | "everyone" (later "group").
  granteeKind        String
  granteePrincipalId String?
  granteePrincipal   Principal? @relation(fields: [granteePrincipalId], references: [id], onDelete: Cascade)
  /// Normalised grantee identity for uniqueness: "principal:<id>", "everyone"
  /// (later "group:<id>"). Needed because NULL granteePrincipalId values are
  /// distinct in a unique index. Shape enforced by a hand-written CHECK
  /// (ResourceGrant_grantee_shape, not representable here).
  granteeKey         String
  /// Per-type ordered level (core/grants.ts LEVELS).
  level              String
  /// "owner" (grant_access), "migration_public", "implied_attachment",
  /// "import", "operator". Audit only.
  source             String     @default("owner")
  /// Principal who created/last changed it. Audit only: plain text, no FK
  /// (same convention as AgentRepository.authorizedById).
  grantedById        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([resourceType, resourceId, granteeKey])
  @@index([granteeKey, resourceType])
  @@index([granteePrincipalId])
}

/// Phase 4: durable handle backing both a triggered run and (reserved,
/// unused this phase) guided tool authoring. Persisted before the
/// tools/call response is returned, so a client's first tasks/get always
/// finds it.
enum TaskKind {
  run
  tool_authoring
}

enum TaskStatus {
  working
  input_required
  completed
  failed
  cancelled
}

model Task {
  id             String     @id @default(cuid())
  kind           TaskKind
  runId          String?
  principalId    String?
  status         TaskStatus @default(working)
  inputRequests  Json?
  inputResponses Json?
  result         Json?
  error          Json?
  ttlAt          DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/// Phase 4: a secret value, encrypted at rest via the SecretCipher seam.
/// `ciphertext` is opaque to Prisma; only the cipher's decrypt() ever
/// produces plaintext, and only at point-of-use inside the sandbox.
model Secret {
  id         String        @id @default(cuid())
  name       String
  ciphertext String
  keyId      String
  ownerId    String?
  owner      Principal?    @relation(fields: [ownerId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  agents     AgentSecret[]

  @@unique([ownerId, name])
}

/// Phase 4: attaches a secret to an agent, addressed at sandbox point-of-use
/// by `boundName` (secrets.get(boundName)). `boundName` defaults to the
/// secret's canonical name; it differs only when the agent binds the secret
/// under an alias, letting two agents resolve the same logical name to
/// different underlying secrets.
model AgentSecret {
  agentId   String
  secretId  String
  boundName String
  agent     Agent  @relation(fields: [agentId], references: [id])
  secret    Secret @relation(fields: [secretId], references: [id])

  @@id([agentId, secretId])
  @@unique([agentId, boundName])
}

/// Cross-instance persistence for the out-of-band secret-entry flow
/// (mcp/tools/secret-elicitation.ts) — was an in-process Map, which stranded
/// a browser-form submission on the wrong instance under a multi-instance
/// HTTP deployment. `outcome` holds the SecretElicitationOutcome JSON;
/// `expiresAt` mirrors the old TTL sweep, now a `DELETE WHERE expiresAt <=
/// now()` instead of a Map scan.
model SecretElicitationOutcome {
  ownerId    String
  secretName String
  outcome    Json
  expiresAt  DateTime

  @@id([ownerId, secretName])
}

enum WebhookStatus {
  enabled
  disabled
}

/// Phase 4: inbound trigger for an agent. `secretHash` is an HMAC/hash of
/// the validation secret shown to the caller once at creation; the raw
/// secret itself is never stored.
model Webhook {
  id          String        @id @default(cuid())
  agentId     String
  agent       Agent         @relation(fields: [agentId], references: [id])
  secretHash  String
  status      WebhookStatus @default(enabled)
  ownerId     String?
  owner       Principal?    @relation(fields: [ownerId], references: [id])
  createdAt   DateTime      @default(now())
  lastFiredAt DateTime?

  @@index([agentId])
}

/// Phase 4 (self-hosted AS only): a registered OAuth client. Created and
/// used only under AUTH_PROVIDER=self-hosted; the delegating adapter never
/// writes these tables even though the migration creates them unconditionally.
model OAuthClient {
  clientId  String                      @id
  metadata  Json
  createdAt DateTime                    @default(now())
  requests  OAuthAuthorizationRequest[]
  codes     OAuthAuthorizationCode[]
  families  OAuthFamily[]
}

/// Phase 4 (self-hosted AS only): an issued authorization grant / refresh token.
model OAuthGrant {
  id               String      @id
  familyId         String
  family           OAuthFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime    @default(now())
  consumedAt       DateTime?
  revokedAt        DateTime?
  replacedById     String?

  @@index([familyId])
  @@index([expiresAt])
}

model AuthUser {
  id          String                   @id @default(cuid())
  principalId String                   @unique
  principal   Principal                @relation(fields: [principalId], references: [id])
  displayName String?
  status      String                   @default("enabled")
  /// wardby roles (src/mcp/auth/resource-server.ts ROLE_PERMISSIONS: admin,
  /// package-approver, service-manager, model-manager), set with `wardby auth user grant`. Empty = member.
  /// A privileged operation needs its scope on the token AND a role here
  /// that grants it; unknown values grant nothing.
  roles       String[]                 @default([])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  loginKeys   AuthLoginKey[]
  sessions    AuthSession[]
  codes       OAuthAuthorizationCode[]
  families    OAuthFamily[]
}

model AuthLoginKey {
  keyId      String    @id
  userId     String
  user       AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  sessionId  String              @id
  userId     String
  user       AuthUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash String
  createdAt  DateTime            @default(now())
  lastSeenAt DateTime            @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  challenges AuthFormChallenge[]

  @@index([userId])
  @@index([expiresAt])
}

model AuthFormChallenge {
  challengeId String       @id
  sessionId   String?
  session     AuthSession? @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  purpose     String
  binding     String
  secretHash  String
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([expiresAt])
}

model OAuthAuthorizationRequest {
  id             String      @id @default(cuid())
  clientId       String
  client         OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  redirectUri    String
  resource       String
  requestedScope String
  codeChallenge  String
  state          String?
  createdAt      DateTime    @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?

  @@index([expiresAt])
}

model OAuthAuthorizationCode {
  codeId        String      @id
  secretHash    String
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId        String
  user          AuthUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  resource      String
  scope         String
  codeChallenge String
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?

  @@index([expiresAt])
}

// The family row serializes refresh/revocation, including creation of replacements.
model OAuthFamily {
  id        String       @id
  clientId  String
  client    OAuthClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId    String
  user      AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  resource  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime     @default(now())
  grants    OAuthGrant[]

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}

/// Which repositories on which code-review host a native agent may act on,
/// and which host events trigger it. See
/// docs/private/2026-09-25-code-review-host-design.md §4.1.
model AgentRepository {
  id                 String   @id @default(cuid())
  agentId            String
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// "github" today; validated in code so adding a host needs no enum migration.
  provider           String
  /// Canonical lower-case owner/name for the provider.
  repository         String
  /// "read" or "write".
  access             String
  /// Subset of "pull_request", "mention", "push", "review_fix".
  triggers           String[] @default([])
  /// Only with the "pull_request" trigger (required there); names the agent's
  /// check. Unique per repository across all links (NULLs are distinct).
  checkName          String?
  /// Only with the "review_fix" trigger: how many automatic fix rounds a
  /// pull request gets before wardby stops. Null = the default (2).
  reviewFixMaxRounds Int?
  /// Only with the "pull_request" trigger: holds this agent's review on a
  /// pushed head until that head's own CI finishes (see DeferredReview),
  /// instead of racing it. Default off: existing links review immediately,
  /// exactly as today.
  waitForCi          Boolean  @default(false)
  createdAt          DateTime @default(now())

  /// How this link was authorized: "host_permission" (the agent owner's
  /// verified host identity had enough access), "admin" (a wardby admin
  /// approved it explicitly), or "grandfathered" (existed before
  /// authorization was enforced). Null = never authorized; use is refused.
  authorizedVia  String?
  /// The principal who authorized it. Audit only: plain text, no FK.
  authorizedById String?
  authorizedAt   DateTime?

  @@unique([agentId, provider, repository])
  @@unique([provider, repository, checkName])
  @@index([provider, repository])
}

/// A pull-request review deferred because its head's CI was still pending
/// (or had not reported) when the triggering push event arrived
/// (AgentRepository.waitForCi). Started either when that head's CI finishes
/// (the ci_completed host event) or by the reconciler's fallback sweep after
/// DEFERRED_REVIEW_MAX_WAIT_MS. Idempotent per
/// (provider, repository, prNumber, headSha, agentId): re-deferring the same
/// head for the same agent is a no-op, not a duplicate row.
model DeferredReview {
  id         String   @id @default(cuid())
  provider   String
  repository String
  prNumber   Int
  headSha    String
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// The agent's check name at defer time, so the delayed review starts
  /// against the same check even if the link's checkName changes later.
  checkName  String
  createdAt  DateTime @default(now())

  @@unique([provider, repository, prNumber, headSha, agentId])
  @@index([provider, repository, headSha])
  @@index([createdAt])
}

/// The host check a run owns, so the review tool can complete it and the
/// run finalizer can close it if the run ends without publishing.
model RunHostCheck {
  runId             String    @id
  run               Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider          String
  repository        String
  checkId           String
  headSha           String
  /// The pull request the run was dispatched for. The review tool only
  /// completes or creates a check for this PR. Null on rows written before it
  /// existed: such a run publishes without a check.
  prNumber          Int?
  completedAt       DateTime?
  /// The verdict the run published on its own check ("APPROVE",
  /// "CHANGES_REQUESTED", "COMMENT"); null until then, or when the check was
  /// closed without one (superseded, or by the finalizer).
  verdict           String?
  /// The published review's summary and body (capped), kept for an automatic
  /// fix round started when the run finishes.
  reviewBody        String?
  /// The run published COMMENT while CI on its head was still running or had
  /// not reported yet. CI finishing on that head later re-runs the review.
  ciPendingAtReview Boolean?
  /// When CI finishing on this head re-ran the review: at most once per head.
  ciRereviewAt      DateTime?
}

/// De-duplicates host webhook redeliveries; pruned after 7 days.
/// The status comment wardby posts on the issue or pull request whose
/// @-mention started this run ("working on it"), edited with the outcome
/// when the run ends. One per mention run.
model RunHostStatus {
  runId                  String    @id
  run                    Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider               String
  repository             String
  /// The issue or pull request number the comment is on.
  number                 Int
  /// "conversation" (issue/PR comment) or "inline" (a reply in a review thread).
  commentKind            String
  /// Null until the "working on it" comment is posted. The row is written
  /// with the run, so a run that dies before the comment exists still gets
  /// an outcome comment (from the reconciler).
  commentId              String?
  /// For an inline mention: the review comment to reply to when the outcome
  /// has to be posted as a new comment.
  replyToReviewCommentId String?
  createdAt              DateTime  @default(now())
  completedAt            DateTime?
}

model HostEventDelivery {
  provider   String
  deliveryId String
  receivedAt DateTime @default(now())

  @@id([provider, deliveryId])
  @@index([receivedAt])
}

/// A principal's verified identity on a code-review host (GitHub today),
/// linked through the host's user-authorization flow (link_host_account).
/// Only the numeric user id and login are stored, never a user token. A host
/// user belongs to at most one principal.
model HostIdentity {
  principalId String
  principal   Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  /// "github" today; validated in code.
  provider    String
  /// The host's numeric user id, as text.
  hostUserId  String
  /// Last known login; refreshed when the host reports a rename.
  login       String
  linkedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([principalId, provider])
  @@unique([provider, hostUserId])
}

/// An in-flight host identity link (link_host_account): the OAuth state and
/// PKCE verifier, then, after the host's callback, the verified user and the
/// hash of the one-time confirmation code the same principal must submit.
/// Lives 10 minutes.
model HostIdentityLinkRequest {
  id           String    @id @default(cuid())
  principalId  String
  principal    Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  provider     String
  /// sha256 of the OAuth state; the state itself is never stored.
  stateHash    String    @unique
  /// PKCE verifier: useless without the authorization code and the client secret.
  codeVerifier String
  hostUserId   String?
  login        String?
  /// sha256 of the confirmation code shown on the callback page.
  confirmHash  String?
  /// Wrong confirmation codes submitted; the request is dead at 5.
  attempts     Int       @default(0)
  callbackAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([principalId])
  @@index([expiresAt])
}

/// Which issue-tracker projects (Jira today) a native agent may act on, and
/// which issue events trigger it. Admin-approved in phase 1 (no way to verify
/// an owner's Jira access). See
/// docs/private/2026-09-30-jira-issue-tracker-design.md §3.
model AgentIssueProject {
  id                    String   @id @default(cuid())
  agentId               String
  agent                 Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// "jira" today; validated in code.
  provider              String
  /// Upper-case Jira project key.
  projectKey            String
  /// "read" or "write".
  access                String
  /// Subset of "created", "transitioned", "labeled", "assigned", "mention".
  triggers              String[] @default([])
  /// With "transitioned": the status names (case-insensitive) that trigger.
  triggerStatuses       String[] @default([])
  /// With "labeled": the labels whose addition triggers.
  triggerLabels         String[] @default([])
  /// Optional JQL the issue must also match for any trigger.
  jqlFilter             String?
  /// Jira accountIds whose @-mention or assignment may trigger (required for those triggers).
  trustedAccountIds     String[] @default([])
  /// Optional project role that the agent's comments are restricted to.
  commentVisibilityRole String?
  /// Target status names (case-insensitive) jira_transition may move issues to. Empty = no transitions.
  allowedTransitions    String[] @default([])
  /// Field ids jira_update_fields may change ("labels", "components", "priority", "customfield_NNNNN"). Empty = none.
  writableFields        String[] @default([])
  /// Issue link type names (case-insensitive) jira_link_issues may create. Empty = linking off.
  allowedLinkTypes      String[] @default([])
  /// Status to move the issue to when a pull request for it opens (a control-plane move, not gated by allowedTransitions). Null = none.
  onPullRequestOpened   String?
  /// Status to move the issue to when a pull request for it merges. Null = none.
  onPullRequestMerged   String?
  /// Issue type names (case-insensitive) jira_create_issue may create. Empty = creation off.
  creatableIssueTypes   String[] @default([])
  /// Cap on issues one run may create in this project. Null = no cap.
  maxNewIssuesPerRun    Int?
  authorizedById        String
  authorizedAt          DateTime @default(now())
  createdAt             DateTime @default(now())

  @@unique([agentId, provider, projectKey])
  @@index([provider, projectKey])
}

/// Dedupe record: an issue wardby created for a fingerprint (several over time — regressions).
model IssueFingerprint {
  id              String   @id @default(cuid())
  issueProvider   String
  projectKey      String
  /// sha256 hex of the agent- or control-plane-supplied fingerprint (raw value never stored).
  fingerprintHash String
  issueKey        String
  agentId         String
  createdByRunId  String?
  seenCount       Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@unique([issueProvider, issueKey])
  @@index([issueProvider, projectKey, fingerprintHash])
  @@index([createdByRunId])
}

/// A pull request wardby opened for a tracker issue (the Jira -> code bridge). Provider-neutral on both sides.
/// Deliberately no foreign keys to Agent or Run: audit-style rows that survive agent/run deletion.
model IssuePullRequest {
  id            String   @id @default(cuid())
  /// "jira"
  issueProvider String
  issueKey      String
  /// "github" today; "bitbucket" next.
  codeProvider  String
  repository    String
  number        Int
  url           String
  /// The issue-linked agent whose run tree opened it (the parent native agent).
  agentId       String
  /// The coding run that opened it (continuePriorRun target for follow-ups).
  openedByRunId String
  /// "open" | "merged" | "closed"
  state         String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([codeProvider, repository, number, issueProvider, issueKey])
  @@index([issueProvider, issueKey])
  /// The admin viewer's outcome lookup by run.
  @@index([openedByRunId])
}

/// The status comment wardby posts on the Jira issue whose event started this
/// run ("working on it"), edited with the outcome when the run ends.
model RunIssueStatus {
  runId          String    @id
  run            Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider       String
  issueKey       String
  /// Null until the "working on it" comment is posted.
  commentId      String?
  visibilityRole String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([completedAt])
}

/// Latest known state of an issue/epic in an external tracker (Jira, later
/// Linear). Shared by every run attributed to it; titles are refreshed by the
/// next snapshot, so reports always show current names.
model WorkItem {
  id           String           @id @default(cuid())
  /// "jira" | "linear" | ...
  provider     String
  /// PAY-241, ENG-123
  key          String
  title        String?
  type         String?
  url          String?
  /// Jira project / Linear team.
  scopeKey     String
  /// The current parent (epic or parent issue), refreshed on each snapshot.
  parentKey    String?
  /// "epic" | "parent" | ...
  parentKind   String?
  /// Last successful snapshot; null = key-only (never snapshotted).
  refreshedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  attributions RunAttribution[]

  @@unique([provider, key])
  @@index([provider, parentKey])
  @@index([provider, scopeKey])
}

/// Which work item a run's cost belongs to, with its parent frozen as of
/// dispatch. Written in dispatchRun's persist transaction; child runs copy
/// their parent's row (source "inherited"). Control-plane data only.
model RunAttribution {
  runId          String   @id
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  workItemId     String
  workItem       WorkItem @relation(fields: [workItemId], references: [id])
  parentKeyAtRun String?
  /// issue_event | linked_pr | explicit | inherited
  source         String
  createdAt      DateTime @default(now())

  @@index([workItemId])
  @@index([parentKeyAtRun])
}

/// Per-run, per-model usage by priced token kind. Sum of costUsd over a
/// run's rows equals Run.costUsd (to Run.costUsd's 6 decimal places).
model RunModelUsage {
  runId             String
  run               Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  model             String
  /// Input tokens NOT served from cache (LlmUsage.inputTokens - cachedInputTokens).
  freshInputTokens  Int     @default(0)
  cachedInputTokens Int     @default(0)
  cacheWriteTokens  Int     @default(0)
  outputTokens      Int     @default(0)
  costUsd           Decimal @default(0) @db.Decimal(18, 10)

  @@id([runId, model])
}

/// A deployment's override of the shipped model catalog
/// (src/providers/llm/catalog-shipped.ts), written by set_model /
/// disable_model (models:admin). A row fully replaces the shipped entry with
/// the same key; enabled=false removes the model; a row with no shipped match
/// adds one. Rates are the provider's exact published numbers (sourceUrl).
model ModelCatalogEntry {
  provider           String
  modelId            String
  enabled            Boolean
  encoding           String
  inputPerMTok       Float
  outputPerMTok      Float
  cachedInputPerMTok Float
  cacheWritePerMTok  Float
  efforts            String[]
  thinkingMode       String
  sourceUrl          String
  updatedBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@id([provider, modelId])
}

/// A local "pull request": a branch compared against a base in a local:
/// repository (git folder on the wardby host), keyed by a durable number so
/// the repo_* review tools work against it like a GitHub pull request.
model LocalPullRequest {
  id         String        @id @default(cuid())
  number     Int           @unique @default(autoincrement())
  /// "local:/abs/path"
  repository String
  branch     String
  base       String
  /// The review run dispatched for this pull request.
  runId      String?       @unique
  run        Run?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  reviews    LocalReview[]

  @@index([repository, branch])
}

/// A review (or a plain comment, verdict COMMENT) published on a LocalPullRequest.
model LocalReview {
  id            String           @id @default(cuid())
  pullRequestId String
  pullRequest   LocalPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  agentId       String
  headSha       String
  /// APPROVE | CHANGES_REQUESTED | COMMENT
  verdict       String
  summary       String
  body          String
  /// [{path, line, side, severity, body}]
  comments      Json
  createdAt     DateTime         @default(now())

  @@index([pullRequestId, createdAt])
}

/// A Slack (chat) channel that receives workflow notifications for a Jira
/// project or for one agent. Exactly one subject: (issueProvider, projectKey)
/// or agentId (enforced in code and by a CHECK constraint). Admin-approved.
/// See docs/slack-notifications.md.
model NotificationChannel {
  id             String    @id @default(cuid())
  /// "slack" today; validated in code.
  provider       String
  /// Slack channel id (C…/G…), upper-case.
  channelId      String
  /// Last known channel name, display only.
  channelName    String?
  issueProvider  String?
  projectKey     String?
  agentId        String?
  agent          Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Subset of the workflow event kinds; empty = all.
  events         String[]  @default([])
  /// Append the run's spend line to messages.
  includeCost    Boolean   @default(false)
  /// Set by the dispatcher on a permanent channel error; cleared by re-linking.
  lastError      String?
  lastErrorAt    DateTime?
  authorizedById String
  authorizedAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@unique([provider, channelId, issueProvider, projectKey])
  @@unique([provider, channelId, agentId])
  @@index([issueProvider, projectKey])
  @@index([agentId])
}

/// One workflow fact (a card picked up, a PR opened, ...). Written only when
/// at least one channel matches. No FKs to Run/Agent: audit-style rows.
model WorkflowEvent {
  id               String                 @id @default(cuid())
  kind             String
  /// Idempotency key: repeated recordings of the same fact are no-ops.
  dedupeKey        String                 @unique
  runId            String?
  agentId          String?
  workItemProvider String?
  workItemKey      String?
  codeProvider     String?
  repository       String?
  prNumber         Int?
  /// Template inputs only: never secrets, code, review bodies or run output.
  payload          Json
  createdAt        DateTime               @default(now())
  deliveries       NotificationDelivery[]

  @@index([createdAt])
}

/// One event's delivery to one channel (the outbox row the dispatcher works).
model NotificationDelivery {
  id            String        @id @default(cuid())
  eventId       String
  event         WorkflowEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider      String
  channelId     String
  threadKey     String
  includeCost   Boolean       @default(false)
  /// "pending" | "delivered" | "failed"
  state         String        @default("pending")
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now())
  lastError     String?
  messageTs     String?
  deliveredAt   DateTime?
  createdAt     DateTime      @default(now())

  @@unique([eventId, provider, channelId])
  @@index([state, nextAttemptAt])
  @@index([provider, channelId, threadKey, createdAt])
}

/// The parent message of a work item's (or PR's) thread in one channel.
model NotificationThread {
  id        String   @id @default(cuid())
  provider  String
  channelId String
  threadKey String
  parentTs  String
  /// Current status line shown on the parent message.
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, channelId, threadKey])
}
