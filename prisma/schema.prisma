// Hand-written per CLEANROOM.md — never generated from another project's
// schema. Targets PostgreSQL even for the laptop demo; "portable" means any
// Postgres (see deploy/local/docker-compose.yml), not a cloud dependency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String   @id @default(cuid())
  name         String   @unique
  systemPrompt String
  model        String
  budgetUsd    Decimal  @db.Decimal(10, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  runs         Run[]

  // Phase 2: scheduling. `schedule` is a cron expression; null = manual-only.
  schedule        String?
  timezone        String    @default("UTC")
  scheduleEnabled Boolean   @default(true)
  /// Start of the most recent due window this agent was fired for.
  lastScheduledAt DateTime?

  // Phase 3: tools + multi-turn loop.
  tools    AgentTool[]
  maxTurns Int         @default(10)
}

enum RunStatus {
  pending
  running
  succeeded
  failed
  refused
  /// Phase 2: orphaned by a dead executor, recovered by the reconciler.
  lost
  /// Phase 3: budget ran out mid-loop; graceful wind-down (or hard-stop)
  /// already applied. Distinct from `refused` (turn-1, zero spend) and
  /// `failed` (an actual error).
  budget_exhausted
}

/// Phase 3: a WASM-sandboxed, Zod-validated tool a model can call.
model Tool {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  /// Zod schema *source text*; compiled and evaluated inside the sandbox,
  /// never in the host process.
  paramsZod   String
  /// Tool body source; run inside the sandbox with the validated params.
  code        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  agents      AgentTool[]
}

/// Phase 3: explicit many-to-many join between Agent and Tool.
model AgentTool {
  agentId String
  toolId  String
  agent   Agent @relation(fields: [agentId], references: [id])
  tool    Tool  @relation(fields: [toolId], references: [id])

  @@id([agentId, toolId])
}

/// Phase 3: the datastore seam's Postgres-backed default. Scoped by agentId
/// so one agent's tools can't read another's state.
model DatastoreEntry {
  agentId   String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([agentId, key])
}

/// Phase 2: how a Run was created.
enum RunTrigger {
  manual
  scheduled
}

model Run {
  id         String     @id @default(cuid())
  agent      Agent      @relation(fields: [agentId], references: [id])
  agentId    String
  status     RunStatus  @default(pending)
  trigger    RunTrigger @default(manual)
  tokensIn   Int        @default(0)
  tokensOut  Int        @default(0)
  costUsd    Decimal    @default(0) @db.Decimal(10, 6)
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  /// Phase 2: beaten by the executor while running; a stale value past
  /// HEARTBEAT_TIMEOUT is how the reconciler finds an orphaned run.
  heartbeatAt DateTime?
}

/// Phase 2: single-row-per-scope lease so exactly one scheduler process
/// ticks at a time. `holder` is a process instance id (crypto.randomUUID()).
model SchedulerLease {
  scope     String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
