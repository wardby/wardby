# Copy to `.env` for defaults everyone shares (still gitignored — this repo
# has none actually safe to commit), or `.env.local` for personal overrides.
# Runtime commands use dotenv-flow's standard cascade. Vitest explicitly loads
# .env -> .env.local -> .env.test -> .env.test.local, while preserving shell/CI
# variables as highest priority. Direct `npx prisma ...` commands read only a
# plain `.env`, which is why DATABASE_URL belongs there as well.
#
# Portable Phase 1 defaults: OpenAI + local Postgres (deploy/local).
DATABASE_URL="postgresql://wardby:wardby@localhost:55432/wardby"
# password (default) | rds-iam. rds-iam authenticates to Amazon RDS with a short-lived IAM
# token: DATABASE_URL then has a user and no password, plus sslmode=verify-full and
# sslrootcert=<RDS CA bundle path> (docs/security-deployment.md, "Database authentication").
# DATABASE_AUTH=password
# Region for the IAM token; falls back to AWS_REGION.
# DATABASE_AWS_REGION=
OPENAI_API_KEY=
# Set LLM_PROVIDER=anthropic to select the Claude adapter (default: openai).
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
# How often (seconds) each process re-reads the model catalog from the database,
# so another process's set_model/disable_model/reset_model reaches it (docs/models.md).
# WARDBY_MODEL_CATALOG_REFRESH_SECONDS=45

# Phase 4: MCP server (`wardby mcp`). stdio is the local/no-OAuth default.
MCP_TRANSPORT=stdio
# host:port — required when MCP_TRANSPORT=http.
MCP_HTTP_BIND=127.0.0.1:8080
# wardby's own canonical URI — required when MCP_TRANSPORT=http (used as the
# OAuth resource identifier and, in self-hosted mode, the AS issuer/audience).
MCP_CANONICAL_URI=
# Optional exact additional MCP browser origins, comma-separated. No paths/wildcards.
# Login, consent, and logout always require the canonical origin.
MCP_ALLOWED_ORIGINS=
# stdio-mode owner identity (no token to derive one from).
LOCAL_PRINCIPAL=local

# AUTH_PROVIDER=delegating (default): wardby is resource-server-only and an
# external IdP issues tokens. Use self-hosted for provisioned-user login,
# consent, and public S256 PKCE clients. See docs/security-deployment.md.
AUTH_PROVIDER=delegating
# delegating mode:
AUTH_ISSUER=
AUTH_JWKS_URI=
AUTH_AUDIENCE=
# Optional, delegating mode: wardby roles from a signed access-token claim.
# Privileged scopes (agents:admin, packages:approve, services:manage, admin:view, models:admin,
# power:manage, hosts:admin) are honoured only for a role granting them (admin: all of them;
# package-approver: packages:approve; service-manager: services:manage; model-manager: models:admin;
# host-manager: hosts:admin). Set both, or neither (then nobody has a role). The claim is an exact top-level
# name first (e.g. groups, roles, or a namespaced https://… claim), else a
# dotted path (e.g. realm_access.roles). The map is idpValue=wardbyRole pairs,
# e.g. wardby-admin=admin,wardby-packages=package-approver,wardby-services=service-manager,wardby-hosts=host-manager.
AUTH_ROLE_CLAIM=
AUTH_ROLE_MAP=
# Must exactly match the normalized MCP_CANONICAL_URI for HTTP.
# Self-hosted keys: independently generated 32-byte keys, each encoded as 64 hex chars.
# Generate each with openssl rand -hex 32; supply via a secret manager in production.
AUTH_SIGNING_KEY=
AUTH_CREDENTIAL_HASH_KEY=
AUTH_MAX_CLIENTS=1000

# Exact normalized hosts only. The only way to let sandboxed tools reach a
# private/loopback address: a "*" tool may use these hosts; a tool with an
# explicit allowedHosts list must also declare the host itself. A tool's own
# list never opens a private address. Cloud metadata endpoints
# (169.254.169.254, metadata.google.internal, ...) stay blocked even if listed.
WARDBY_FETCH_ALLOWED_HOSTS=

# SECRET_CIPHER=app-key (default): AES-256-GCM with a local master key.
# kms is reserved (no adapter yet).
SECRET_CIPHER=app-key
# 32 bytes of hex (64 hex chars) — e.g. `openssl rand -hex 32`.
SECRET_APP_KEY=

# Local browser-backed security tests can reuse an installed Chrome instead of
# downloading Playwright Chromium. CI should install Playwright's pinned browser.
SECURITY_BROWSER_CHANNEL=

# Required only for a multi-instance HTTP deployment: shares the MCP
# requestState HMAC key across instances, so a secret-elicitation token
# minted on one instance verifies on another. 32 bytes of hex (64 hex
# chars) — e.g. `openssl rand -hex 32`. Leave unset for stdio or a
# single-instance HTTP deployment (each process falls back to its own
# random key, which is fine when only one process ever sees a given token).
REQUEST_STATE_KEY=

# Phase 5 containerized coding executor. The native executor remains the
# default; all values below are used only when JOB_LAUNCHER=docker.
JOB_LAUNCHER=local
# Codex agents: immutable repository digest or Docker local image ID, never a mutable tag.
# Optional when Claude Code's CODING_CLAUDE_WORKER_IMAGE and CODING_CLAUDE_TOOL_RUNNER_IMAGE
# are set instead; at least one provider's images are required.
CODING_WORKER_IMAGE=
# Required: dedicated proxy container already attached to its external network.
CODING_PROXY_CONTAINER=
# Trusted host roots. VCS_WORK_ROOT is also the Docker launcher's seed/materialize root.
VCS_WORK_ROOT=
CODING_JOB_STATE_ROOT=
CODING_ARTIFACT_ROOT=
# Reference resolved only by the trusted proxy process; never passed to the worker.
CODING_OPENAI_CREDENTIAL_REF=env:OPENAI_API_KEY
CODING_CPUS=1
CODING_MEMORY_MB=2048
CODING_PIDS=128
CODING_DISK_MB=2048
# Operator ceiling (MiB) on a coding profile's per-agent workspaceDiskMb; must be >= CODING_DISK_MB.
# Defaults to CODING_DISK_MB, so raising it is a deliberate opt-in (on Docker the workspace is tmpfs,
# i.e. RAM, and every concurrent run can claim this much).
CODING_MAX_DISK_MB=2048
# Claude Code runs only: ms a shell command gets by default, and the most it may ask for (map to
# Claude Code's BASH_DEFAULT_TIMEOUT_MS / BASH_MAX_TIMEOUT_MS). 1000-7200000, each capped at the
# run's timeoutSec. Default 600000 each.
# CODING_BASH_DEFAULT_TIMEOUT_MS=600000
# CODING_BASH_MAX_TIMEOUT_MS=600000
# Coding runs holding a slot at once, across all control-plane replicas
# (enforced in Postgres). Runs over the cap wait in a FIFO queue.
CODING_MAX_CONCURRENT=4
# Seconds a coding run may wait for a slot before failing (coding_queue_timeout).
CODING_QUEUE_TIMEOUT_SEC=3600
# Most repositories one coding run may hold, the default one included (1-17;
# default 5). A value outside that range stops start-up.
# CODING_MAX_RUN_REPOSITORIES=5
# Largest result bundle (MB) collected from a run with git history (default 256;
# never more than the run's disk). A larger bundle fails the run.
# CODING_MAX_RESULT_BUNDLE_MB=256

# JOB_LAUNCHER=kubernetes: coding runs as pods (see deploy/kind-coding/ locally).
# Namespace holding coding-run pods and the in-cluster coding proxy.
KUBERNETES_NAMESPACE=wardby-coding
# kubeconfig context to use; unset = current context, or in-cluster credentials.
KUBERNETES_CONTEXT=
KUBERNETES_PROXY_SERVICE=wardby-coding-proxy
# Required RuntimeClass for coding pods (e.g. gvisor on GKE). Unset = development
# cluster: the launcher logs a warning on every launch.
KUBERNETES_RUNTIME_CLASS=
# PriorityClass for coding-run pods (e.g. wardby-coding-run in the GKE overlay).
# Unset = no class. The class must already exist in the cluster.
KUBERNETES_RUN_PRIORITY_CLASS=

# Phase 7 observability. Disabled unless an explicit bind is supplied. Keep
# production on loopback; the local Grafana Compose profile uses its private
# network and explicitly enables 0.0.0.0 without publishing this port.
METRICS_BIND=
METRICS_ALLOW_NON_LOOPBACK=false

# GitHub App installation used for scoped clone, branch push, and draft PR creation.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_VERSION=2026-03-10
VCS_MAX_CHANGED_FILES=1000
VCS_MAX_DIFF_BYTES=1048576

# Secret shared with the GitHub App's webhook settings; enables /hosts/github/events.
GITHUB_APP_WEBHOOK_SECRET=

# The GitHub App's OAuth Client ID (not the numeric App ID) and a client secret
# generated under the App's "Client secrets". Set both or neither: they enable
# link_host_account (a principal links its GitHub identity so repository
# access can be checked) and the /hosts/github/user-callback page, whose URL
# must be registered as the App's Callback URL. Unset = linking is disabled;
# repository authorization is still enforced.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Optional: GitHub accounts (users or orgs, comma-separated) the GitHub App
# serves in addition to its owner. Unset = the App's owner only. Every other
# account is refused: its events are ignored and its repositories refused. The
# App is removed when another account installs it or changes its repository
# selection; remove existing installations on other accounts by hand (App
# settings > Install App).
# WARDBY_GITHUB_ALLOWED_ACCOUNTS=acme-labs

# --- Mobile app sign-in (optional; see help article mobile-app) ---
# Off by default. Set to true to let the self-hosted OAuth server accept the
# mobile app's private-use redirect URI (exact match only). Admins then sign in
# with the app; sign-in needs the admin:view scope. Turning it off refuses new
# sign-ins and token refreshes (access tokens already issued last at most 10
# minutes). A malformed value stops startup.
# WARDBY_MOBILE_ENABLED=false
# White-label builds only: the redirect URI your own app build uses. Default
# com.wardby.mobile:/oauth. Must be a reverse-domain private-use URI such as
# com.example.app:/oauth (lowercase scheme containing a dot, ":/", then a path;
# no host, query or fragment). Changing it signs out app clients registered
# under the old value.
# WARDBY_MOBILE_REDIRECT_URI=com.example.app:/oauth

# --- Jira Cloud (optional; see docs/jira-agents.md) ---
# wardby acts in Jira as an Atlassian service account, never a person's account:
# every comment and change an agent makes is attributed to this account.
# The site people browse (bare origin). Issue links in comments point here.
WARDBY_JIRA_SITE_URL=
# The service account's API token and the Atlassian API gateway for your site.
WARDBY_JIRA_API_TOKEN=
WARDBY_JIRA_API_BASE_URL=https://api.atlassian.com/ex/jira/<cloudId>
# Optional: the token's expiry date (YYYY-MM-DD); wardby warns 14 days ahead.
WARDBY_JIRA_API_TOKEN_EXPIRES_AT=
# Optional: field id of the legacy Epic Link field (company-managed projects), so
# cost reports group runs under their epic, e.g. customfield_10014.
# WARDBY_JIRA_EPIC_LINK_FIELD=
# The secret you set on the Jira webhook (20+ characters).
WARDBY_JIRA_WEBHOOK_SECRET=

# Slack workflow notifications (outbound only). See docs/slack-notifications.md.
# WARDBY_SLACK_BOT_TOKEN=xoxb-...
# WARDBY_SLACK_CUSTOMIZE=false
# WARDBY_SLACK_API_BASE_URL=https://slack.com/api

# EXECUTOR=in-process (default): heartbeat + reconciler durability; a run whose
# process dies is reconciled to `lost`. EXECUTOR=dbos: each run is a DBOS
# durable workflow that resumes from its last completed LLM turn / tool call
# after a crash or redeploy, and `stop` is a real cancellation.
EXECUTOR=in-process
# Seconds `wardby serve` / `wardby mcp` (HTTP) waits on SIGTERM for the native
# runs it is executing to finish before closing the executor; 0 = do not wait.
# Keep the platform's termination grace period above this.
SHUTDOWN_DRAIN_SECONDS=600
# DBOS keeps its workflow tables in schema DBOS_SCHEMA of this database.
# Defaults to DATABASE_URL; point elsewhere to keep them in a separate DB.
DBOS_SYSTEM_DATABASE_URL=
DBOS_SCHEMA=dbos
# REQUIRED when EXECUTOR=dbos (no default — EXECUTOR=dbos refuses to start
# without it). A restarted process with the same id re-drives its own
# interrupted runs at launch, so two processes sharing an id each re-drive the
# other's live workflows: the scheduler and the MCP server need DIFFERENT
# values (e.g. scheduler-1 and mcp-1).
DBOS_EXECUTOR_ID=

# Trusted parent folders for local repositories (`local:/abs/path`), separated by
# the platform path delimiter (":" on Linux/macOS). A local repository must be a
# git work tree at or under one of these. Unset = local repositories disabled.
# LOCAL_REPO_ROOTS=/home/you/code
